class Output:
    def __init__(self, args):
        self.args = args
        self.format = args.format or ("table" if sys.stdout.isatty() else "tsv")
        self.path_maps = []
        for item in args.path_map or []:
            if "=" not in item:
                raise UsageError(f"--path-map: expected FROM=TO, not {item!r}")
            source, target = item.split("=", 1)
            self.path_maps.append((source.rstrip("/"), target.rstrip("/")))

    def map_path(self, path):
        if not path:
            return path
        for source, target in sorted(self.path_maps, key=lambda m: -len(m[0])):
            if path == source or path.startswith(source + "/"):
                return target + path[len(source):]
        return path

    def value(self, column, value, for_format):
        if column.kind == "path":
            value = self.map_path(value)
        if for_format in ("json", "jsonl"):
            if column.kind == "time":
                return iso(value)
            return value
        if value is None:
            return ""
        if column.kind == "time":
            return value.astimezone().strftime("%Y-%m-%d %H:%M") if for_format == "table" else iso(value)
        if column.kind == "size" and for_format == "table":
            return human_size(value)
        if column.kind == "id" and for_format == "table" and not self.args.full_ids:
            text = str(value)
            return text if text.startswith(METADATA_ONLY_PREFIX) else text[:10]
        if column.kind == "list":
            return ", ".join(str(v) for v in value) if for_format == "table" else "; ".join(str(v) for v in value)
        if column.kind == "bool":
            if for_format == "table":
                return "yes" if value else "no"
            return "true" if value else "false"
        text = str(value)
        if for_format != "csv":
            text = re.sub(r"[\t\r\n]+", " ", text)
        return text

    def pick_columns(self, available, default, id_column):
        requested = self.args.columns
        if requested == "help":
            width = max(len(n) for n in available)
            for name, column in available.items():
                print(f"{name.ljust(width)}  {column.description}")
            raise SystemExit(EXIT_OK)
        if self.args.ids_only:
            return [available[id_column]]
        if requested:
            names = split_values([requested])
            if names == ["all"]:
                return list(available.values())
            unknown = [n for n in names if n not in available]
            if unknown:
                raise UsageError(f"--columns: unknown column(s) {', '.join(unknown)}; see --columns help")
            return [available[n] for n in names]
        if self.format in ("json", "jsonl"):
            return list(available.values())
        return [available[n] for n in default]

    def sort(self, rows, available, default_key, default_reverse=False):
        key = self.args.sort or default_key
        if key not in available:
            raise UsageError(f"--sort: unknown column {key!r}; see --columns help")
        column = available[key]

        def sort_key(row):
            value = row.get(key)
            if value is None:
                return (1, "")
            if column.kind == "list":
                value = ", ".join(str(v) for v in value).lower()
            elif isinstance(value, str):
                value = value.lower()
            return (0, value)

        reverse = default_reverse if not self.args.sort else False
        if self.args.reverse:
            reverse = not reverse
        present = [r for r in rows if r.get(key) is not None]
        missing = [r for r in rows if r.get(key) is None]
        return sorted(present, key=sort_key, reverse=reverse) + missing

    def emit(self, rows, available, default_columns, default_sort, default_reverse=False, id_column="id"):
        """Sorts, limits and prints rows. Returns the exit status: 1 when nothing matched.

        With no default_sort, the rows keep their order unless --sort is given."""
        if self.args.count:
            print(len(rows))
            return EXIT_OK
        chosen = self.pick_columns(available, default_columns, id_column)
        if default_sort is None and not self.args.sort:
            rows = list(reversed(rows)) if self.args.reverse else rows
        else:
            rows = self.sort(rows, available, default_sort, default_reverse)
        if self.args.limit is not None:
            rows = rows[: self.args.limit]
        if self.args.ids_only:
            self.write_lines([self.value(chosen[0], r.get(chosen[0].name), "tsv") for r in rows])
        elif self.format == "json":
            json.dump([{c.name: self.value(c, r.get(c.name), "json") for c in chosen} for r in rows],
                      sys.stdout, indent=2, ensure_ascii=False)
            print()
        elif self.format == "jsonl":
            for r in rows:
                print(json.dumps({c.name: self.value(c, r.get(c.name), "json") for c in chosen}, ensure_ascii=False))
        elif self.format == "csv":
            writer = csv.writer(sys.stdout, lineterminator="\n")
            if not self.args.no_header:
                writer.writerow([c.name for c in chosen])
            for r in rows:
                writer.writerow([self.value(c, r.get(c.name), "csv") for c in chosen])
        elif self.format == "tsv":
            lines = ["\t".join(self.value(c, r.get(c.name), "tsv") for c in chosen) for r in rows]
            if self.args.header:
                lines.insert(0, "\t".join(c.name for c in chosen))
            self.write_lines(lines)
        else:
            self.table(chosen, [[self.value(c, r.get(c.name), "table") for c in chosen] for r in rows])
        return EXIT_OK if rows else EXIT_EMPTY

    def write_lines(self, lines):
        end = "\0" if self.args.null else "\n"
        for line in lines:
            sys.stdout.write(line + end)

    def table(self, chosen, cells):
        if not cells:
            return
        headers = [c.name.upper() for c in chosen]
        widths = [max([len(h)] + [display_width(row[i]) for row in cells]) for i, h in enumerate(headers)]
        if sys.stdout.isatty() and not self.args.wide:
            available = shutil.get_terminal_size((120, 24)).columns - 2 * (len(widths) - 1)
            flexible = [i for i, c in enumerate(chosen) if c.flex]
            while sum(widths) > available and flexible:
                widest = max(flexible, key=lambda i: widths[i])
                floor = max(len(headers[widest]), 12)
                if widths[widest] <= floor:
                    flexible.remove(widest)
                    continue
                widths[widest] -= 1
        right = [c.kind in ("int", "size") for c in chosen]

        lines = []
        if not self.args.no_header:
            lines.append("  ".join(fit_width(h, w, r) for h, w, r in zip(headers, widths, right)).rstrip())
        for row in cells:
            lines.append("  ".join(fit_width(v, w, r) for v, w, r in zip(row, widths, right)).rstrip())
        self.write_lines(lines)


def within(value, args):
    if args.since and (value is None or value < args.since):
        return False
    if args.until and (value is None or value >= args.until):
        return False
    return True


