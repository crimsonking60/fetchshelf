def torrent_status(row):
    if row["Id"].startswith(METADATA_ONLY_PREFIX):
        return "metadata-only"
    if row["LibraryPath"] is not None:
        return "linked"
    if row["UnlinkedAt"] is not None:
        return "unlinked"
    if row["ReplacedWithTorrentId"] is not None:
        return "replaced"
    return "waiting"


def torrent_row(row):
    metadata = load_json(row["MetadataJson"], {})
    files = load_json(row["LinkedFilesJson"], []) or []
    formats = [f for f in (row["ChosenAudioExtension"], row["ChosenEbookExtension"]) if f]
    return {
        "id": row["Id"],
        "mam_id": row["MamId"],
        "title": row["Title"],
        "authors": metadata.get("Authors") or [],
        "narrators": metadata.get("Narrators") or [],
        "series": series_labels(metadata),
        "media_type": kebab(metadata.get("MediaType")),
        "language": metadata.get("Language"),
        "status": torrent_status(row),
        "library": row["LinkerName"],
        "category": row["QBittorrentCategory"],
        "client_status": row["ClientStatus"],
        "mismatch": kebab(row["LibraryMismatchState"]),
        "format": ", ".join(formats) or None,
        "file_types": metadata.get("FileTypes") or [],
        "size": metadata.get("TotalSizeBytes"),
        "linked_size": sum(f.get("SizeBytes") or 0 for f in files) if files else None,
        "files": len(files),
        "added": parse_time(row["CreatedAt"]),
        "unlinked": parse_time(row["UnlinkedAt"]),
        "replaced": parse_time(row["ReplacedAt"]),
        "replaced_by": row["ReplacedWithTorrentId"],
        "abs_id": row["AbsId"],
        "path": row["LibraryPath"],
        "url": MAM_URL.format(row["MamId"]) if row["MamId"] else None,
        "_files": files,
        "_metadata": metadata,
    }


def all_torrents(db):
    return [torrent_row(r) for r in db.execute("SELECT * FROM Torrents")]


def resolve_torrent(db, ident):
    """A full info-hash, a unique prefix of at least 4 characters, mam:<id>, or a MAM id."""
    ident = ident.strip()
    rows = db.execute("SELECT * FROM Torrents WHERE Id = ?", (ident.lower(),)).fetchall()
    if not rows and ident.isdigit():
        rows = db.execute("SELECT * FROM Torrents WHERE MamId = ?", (int(ident),)).fetchall()
    if not rows and len(ident) >= 4 and re.fullmatch(r"[0-9a-fA-F]+", ident):
        rows = db.execute("SELECT * FROM Torrents WHERE Id LIKE ? || '%'", (ident.lower(),)).fetchall()
    if not rows:
        return None
    if len(rows) > 1:
        choices = "\n".join(f"  {r['Id']}  {r['Title']}" for r in rows)
        raise UsageError(f"{ident!r} matches {len(rows)} torrents; use more of the info-hash:\n{choices}")
    return torrent_row(rows[0])


def matches_text(value, needle):
    if value is None:
        return False
    if isinstance(value, list):
        return any(needle in str(v).lower() for v in value)
    return needle in str(value).lower()


def filter_torrents(rows, args):
    statuses = split_values(args.status)
    check_choices(statuses, TORRENT_STATUSES + ["not-linked"], "--status")
    wanted = {loose(s) for s in statuses}
    if loose("not-linked") in wanted:
        wanted |= {loose(s) for s in TORRENT_STATUSES if s != "linked"}
    problems = split_values(args.problem)
    check_choices(problems, ["any", "mismatch", "not-in-client"], "--problem")

    def keep(t):
        if wanted and loose(t["status"]) not in wanted:
            return False
        if problems:
            mismatch, gone = t["mismatch"] is not None, t["client_status"] == NOT_IN_CLIENT
            if not any({"any": mismatch or gone, "mismatch": mismatch, "notinclient": gone}[loose(p)]
                       for p in problems):
                return False
        for option, field in (("library", "library"), ("category", "category"),
                              ("media_type", "media_type"), ("language", "language")):
            values = split_values(getattr(args, option))
            if values and loose(t[field]) not in {loose(v) for v in values}:
                return False
        if args.author and not matches_text(t["authors"], args.author.lower()):
            return False
        if args.series and not matches_text(t["series"], args.series.lower()):
            return False
        if args.query:
            needle = " ".join(args.query).lower()
            if not any(matches_text(t[f], needle) for f in ("title", "authors", "narrators", "series", "id")):
                return False
        return True

    return [t for t in rows if keep(t)]


