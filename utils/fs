REQUIRED_TABLES = {"Torrents", "Events", "SelectedTorrents", "ErroredTorrents", "DuplicateTorrents"}


class Database(sqlite3.Connection):
    """A connection that also knows which tables the database has."""

    tables = frozenset()


def database_path(args):
    path = args.db or os.environ.get("FETCHSHELF_DB") or os.environ.get("FETCHSHELF_DATA_FILE") or "data.db"
    return os.path.expanduser(path)


def open_database(args):
    path = database_path(args)
    if not os.path.isfile(path):
        raise UsageError(f"no database at {path}; set FETCHSHELF_DB or use --db")
    try:
        connection = sqlite3.connect(f"file:{path}?mode=ro", uri=True, factory=Database)
        connection.row_factory = sqlite3.Row
        connection.execute("PRAGMA query_only = ON")
        tables = {row[0] for row in connection.execute("SELECT name FROM sqlite_master WHERE type = 'table'")}
    except sqlite3.Error as error:
        raise UsageError(f"can't read {path}: {error}")
    missing = REQUIRED_TABLES - tables
    if missing:
        raise UsageError(f"{path} is not a Fetchshelf database (no {', '.join(sorted(missing))} table)")
    connection.tables = tables
    return connection


