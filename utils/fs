def cmd_torrents(db, args, out):
    rows = [t for t in filter_torrents(all_torrents(db), args) if within(t["added"], args)]
    return out.emit(rows, TORRENT_COLUMNS, ["id", "mam_id", "title", "authors", "status", "library", "added"], "title")


def cmd_torrent(db, args, out):
    torrent = resolve_torrent(db, args.torrent)
    if torrent is None:
        print(f"fs: no torrent matches {args.torrent!r}", file=sys.stderr)
        return EXIT_EMPTY
    events = [event_row(r, {torrent["id"]: torrent["title"]})
              for r in db.execute("SELECT * FROM Events WHERE TorrentId = ? ORDER BY Id", (torrent["id"],))]
    errors = [error_row(r) for r in db.execute(
        "SELECT * FROM ErroredTorrents WHERE Key = ? OR Key = ? ORDER BY OccurredAt",
        (torrent["id"], str(torrent["mam_id"])))]
    duplicates = [r["MamId"] for r in db.execute(
        "SELECT MamId FROM DuplicateTorrents WHERE DuplicateOfTorrentId = ?", (torrent["id"],))]
    files = [{"path": out.map_path(os.path.join(torrent["path"], f.get("RelativePath", ""))) if torrent["path"]
              else f.get("RelativePath"), "size": f.get("SizeBytes")} for f in torrent["_files"]]

    if out.format in ("json", "jsonl"):
        record = {c.name: out.value(c, torrent[c.name], "json") for c in TORRENT_COLUMNS.values()}
        record.update({
            "description": torrent["_metadata"].get("Description"),
            "linked_files": files,
            "events": [{c.name: out.value(c, e[c.name], "json") for c in EVENT_COLUMNS.values()} for e in events],
            "errors": [{c.name: out.value(c, e[c.name], "json") for c in ERROR_COLUMNS.values()} for e in errors],
            "duplicates_skipped": duplicates,
            "metadata": torrent["_metadata"],
        })
        print(json.dumps(record, indent=2 if out.format == "json" else None, ensure_ascii=False))
        return EXIT_OK

    pretty = out.format == "table"
    args.full_ids = True
    fields = [(c.name, out.value(c, torrent[c.name], "table" if pretty else "tsv")) for c in TORRENT_COLUMNS.values()]
    if not pretty:
        for name, value in fields:
            print(f"{name}\t{value}")
        for f in files:
            print(f"file\t{f['path']}")
        for e in events:
            print(f"event\t{iso(e['time'])} {e['kind']} {e['detail']}".rstrip())
        for e in errors:
            print(f"error\t{e['stage']}: {e['error']}")
        return EXIT_OK
    width = max(len(n) for n, _ in fields)
    for name, value in fields:
        if value != "" and not (name == "files" and value == "0"):
            print(f"{name.ljust(width)}  {value}")
    if files:
        print("\nLinked files")
        for f in files:
            print(f"  {f['path']}  ({human_size(f['size'])})")
    if events:
        print("\nEvents")
        for e in events:
            print(f"  {e['time'].astimezone().strftime('%Y-%m-%d %H:%M')}  {e['kind']:<16} {e['detail']}".rstrip())
    if errors:
        print("\nErrors")
        for e in errors:
            print(f"  {e['time'].astimezone().strftime('%Y-%m-%d %H:%M')}  {e['stage']}: {e['error']}")
    if duplicates:
        print("\nDuplicates skipped in its favour")
        for mam_id in duplicates:
            print(f"  {MAM_URL.format(mam_id)}")
    return EXIT_OK


def cmd_files(db, args, out):
    if not args.status:
        args.status = ["linked"]
    rows = []
    check = args.missing or args.present or (args.columns and "exists" in split_values([args.columns]))
    for t in filter_torrents(all_torrents(db), args):
        if not within(t["added"], args) or not t["path"]:
            continue
        for f in t["_files"]:
            path = os.path.join(t["path"], f.get("RelativePath", ""))
            row = {"path": path, "size": f.get("SizeBytes"), "id": t["id"], "mam_id": t["mam_id"],
                   "title": t["title"], "library": t["library"], "exists": None}
            if check:
                row["exists"] = os.path.lexists(out.map_path(path))
                if (args.missing and row["exists"]) or (args.present and not row["exists"]):
                    continue
            rows.append(row)
    return out.emit(rows, FILE_COLUMNS, ["path"], "path", id_column="path")


def event_row(row, titles):
    kind = EVENT_KINDS[row["Kind"]] if 0 <= row["Kind"] < len(EVENT_KINDS) else str(row["Kind"])
    removed = load_json(row["FilesRemovedJson"], None)
    changes = [f"{c.get('Field')}: {c.get('From')} -> {c.get('To')}" for c in load_json(row["FieldChangesJson"], [])]
    if kind == "grabbed":
        detail = " ".join(p for p in (row["GrabberName"], f"({kebab(row['Cost'])})" if row["Cost"] else None,
                                      "wedge" if row["WedgeUsed"] else None) if p)
    elif kind == "updated":
        detail = "; ".join(changes)
    elif kind in ("linked", "cleaned", "unlinked"):
        detail = row["LibraryPath"] or ""
        if removed:
            detail = (detail + f" ({len(removed)} file(s) removed)").strip()
    else:
        detail = ""
    return {
        "event_id": row["Id"],
        "time": parse_time(row["OccurredAt"]),
        "kind": kind,
        "id": row["TorrentId"],
        "mam_id": row["MamId"],
        "title": titles.get(row["TorrentId"]),
        "grabber": row["GrabberName"],
        "cost": kebab(row["Cost"]),
        "wedge": None if row["WedgeUsed"] is None else bool(row["WedgeUsed"]),
        "library": row["LinkerName"],
        "path": row["LibraryPath"],
        "files_removed": removed if removed is not None else [],
        "changes": changes,
        "detail": detail,
    }


def cmd_events(db, args, out):
    kinds = split_values(args.kind)
    check_choices(kinds, EVENT_KINDS, "--kind")
    sql, params = "SELECT * FROM Events", []
    if args.torrent:
        torrent = resolve_torrent(db, args.torrent)
        if torrent is not None:
            sql, params = sql + " WHERE TorrentId = ?", [torrent["id"]]
        elif args.torrent.isdigit():
            sql, params = sql + " WHERE MamId = ?", [int(args.torrent)]
        else:
            sql, params = sql + " WHERE TorrentId LIKE ? || '%'", [args.torrent.lower()]
    titles = {r["Id"]: r["Title"] for r in db.execute("SELECT Id, Title FROM Torrents")}
    rows = [event_row(r, titles) for r in db.execute(sql, params)]
    rows = [e for e in rows if within(e["time"], args) and (not kinds or loose(e["kind"]) in {loose(k) for k in kinds})]
    if args.query:
        needle = " ".join(args.query).lower()
        rows = [e for e in rows if any(matches_text(e[f], needle) for f in ("title", "detail", "id"))]
    return out.emit(rows, EVENT_COLUMNS, ["time", "kind", "mam_id", "title", "detail"], "event_id", True)


def selected_row(row):
    metadata = load_json(row["MetadataJson"], {})
    state = "removed" if row["RemovedAt"] else "downloading" if row["StartedAt"] else "queued"
    return {
        "selected_id": row["Id"],
        "mam_id": row["MamId"],
        "title": metadata.get("Title"),
        "authors": metadata.get("Authors") or [],
        "media_type": kebab(metadata.get("MediaType")),
        "state": state,
        "cost": kebab(row["CostDecision"]),
        "grabber": row["GrabberName"],
        "category": row["Category"],
        "tags": load_json(row["TagsJson"], []) or [],
        "size": metadata.get("TotalSizeBytes"),
        "added": parse_time(row["CreatedAt"]),
        "started": parse_time(row["StartedAt"]),
        "removed": parse_time(row["RemovedAt"]),
        "url": MAM_URL.format(row["MamId"]),
    }


def cmd_selected(db, args, out):
    states = split_values(args.state) or ["queued", "downloading"]
    if states == ["all"]:
        states = SELECTED_STATES
    check_choices(states, SELECTED_STATES, "--state")
    rows = [selected_row(r) for r in db.execute("SELECT * FROM SelectedTorrents")]
    rows = [s for s in rows if s["state"] in states and within(s["added"], args)]
    grabbers = split_values(args.grabber)
    if grabbers:
        rows = [s for s in rows if loose(s["grabber"]) in {loose(g) for g in grabbers}]
    if args.query:
        needle = " ".join(args.query).lower()
        rows = [s for s in rows if any(matches_text(s[f], needle) for f in ("title", "authors"))]
    return out.emit(rows, SELECTED_COLUMNS, ["selected_id", "mam_id", "title", "state", "cost", "grabber", "added"],
                    "selected_id", id_column="mam_id")


def error_row(row):
    stage = ERROR_STAGES[row["Stage"]] if 0 <= row["Stage"] < len(ERROR_STAGES) else str(row["Stage"])
    title = row["Title"] if "Title" in row.keys() else None
    if not title:
        title = load_json(row["DisplayMetadataJson"], {}).get("Title")
    return {"error_id": row["Id"], "stage": stage, "key": row["Key"], "title": title,
            "error": row["ErrorText"], "time": parse_time(row["OccurredAt"])}


def cmd_errors(db, args, out):
    stages = split_values(args.stage)
    check_choices(stages, ERROR_STAGES, "--stage")
    rows = [error_row(r) for r in db.execute("SELECT * FROM ErroredTorrents")]
    rows = [e for e in rows if within(e["time"], args) and (not stages or e["stage"] in stages)]
    return out.emit(rows, ERROR_COLUMNS, ["time", "stage", "key", "title", "error"], "time", True,
                    id_column="key")


def cmd_duplicates(db, args, out):
    titles = {r["Id"]: r["Title"] for r in db.execute("SELECT Id, Title FROM Torrents")}
    rows = []
    for r in db.execute("SELECT * FROM DuplicateTorrents"):
        metadata = load_json(r["MetadataJson"], {})
        rows.append({
            "duplicate_id": r["Id"], "mam_id": r["MamId"], "title": metadata.get("Title"),
            "authors": metadata.get("Authors") or [], "media_type": kebab(metadata.get("MediaType")),
            "size": metadata.get("TotalSizeBytes"), "duplicate_of": r["DuplicateOfTorrentId"],
            "duplicate_of_title": titles.get(r["DuplicateOfTorrentId"]), "added": parse_time(r["CreatedAt"]),
            "url": MAM_URL.format(r["MamId"]),
        })
    rows = [d for d in rows if within(d["added"], args)]
    return out.emit(rows, DUPLICATE_COLUMNS, ["added", "mam_id", "title", "duplicate_of", "duplicate_of_title"],
                    "added", True, id_column="mam_id")


def require_lists(db):
    if not {"Lists", "ListItems"} <= db.tables:
        raise UsageError("this database has no lists; it predates Hardcover list support")


def cmd_lists(db, args, out):
    require_lists(db)
    rows = []
    for r in db.execute("""
            SELECT l.*,
                   SUM(i.ExternalId IS NOT NULL AND i.RemovedAt IS NULL) AS Books,
                   SUM(i.MarkedDoneAt IS NOT NULL) AS Done,
                   SUM(i.RemovedAt IS NOT NULL) AS Removed
            FROM Lists l LEFT JOIN ListItems i ON i.ListId = l.Id
            GROUP BY l.Id"""):
        rows.append({"list_id": r["Id"], "name": r["Name"], "type": r["ListType"], "books": r["Books"] or 0,
                     "done": r["Done"] or 0, "removed": r["Removed"] or 0,
                     "added": parse_time(r["CreatedAt"]), "updated": parse_time(r["UpdatedAt"])})
    return out.emit(rows, LIST_COLUMNS, ["list_id", "name", "books", "done", "updated"], "name",
                    id_column="list_id")


def cmd_list_items(db, args, out):
    require_lists(db)
    statuses = split_values(args.status)
    allowed = ["selected", "wanted", "not-wanted", "existing", "not-found", "none"]
    check_choices(statuses, allowed, "--status")
    rows = []
    for r in db.execute("SELECT * FROM ListItems"):
        series = r["SeriesName"]
        if series and r["SeriesNumber"] is not None:
            series += f" #{r['SeriesNumber']:g}"
        rows.append({
            "list_id": r["ListId"], "position": r["Position"], "external_id": r["ExternalId"],
            "title": r["BookTitle"], "authors": load_json(r["AuthorsJson"], []), "series": series,
            "prefer": loose(r["PreferFormat"]) or None,
            "audio_status": kebab(r["AudioStatus"]) if r["AllowAudio"] else None, "audio_mam_id": r["AudioMamId"],
            "ebook_status": kebab(r["EbookStatus"]) if r["AllowEbook"] else None, "ebook_mam_id": r["EbookMamId"],
            "searched": parse_time(r["LastSearchedAt"]), "added": parse_time(r["CreatedAt"]),
            "done": parse_time(r["MarkedDoneAt"]), "removed": parse_time(r["RemovedAt"]), "url": r["BookUrl"],
        })
    if args.list:
        rows = [i for i in rows if i["list_id"] == args.list or loose(i["list_id"]).endswith(loose(args.list))]
    if not args.all:
        rows = [i for i in rows if i["done"] is None and i["removed"] is None]
    if statuses:
        wanted = {loose(s) for s in statuses}
        rows = [i for i in rows
                if loose(i["audio_status"] or "none") in wanted or loose(i["ebook_status"] or "none") in wanted]
    if args.query:
        needle = " ".join(args.query).lower()
        rows = [i for i in rows if any(matches_text(i[f], needle) for f in ("title", "authors", "series"))]
    rows = [i for i in rows if within(i["added"], args)]
    return out.emit(rows, LIST_ITEM_COLUMNS,
                    ["list_id", "position", "title", "authors", "audio_status", "ebook_status"], "position",
                    id_column="external_id")


def cmd_stats(db, args, out):
    torrents = all_torrents(db)

    def tally(field):
        counts = {}
        for t in torrents:
            key = t[field] if t[field] is not None else "(none)"
            counts[key] = counts.get(key, 0) + 1
        return dict(sorted(counts.items(), key=lambda kv: (-kv[1], str(kv[0]))))

    selected = [selected_row(r) for r in db.execute("SELECT * FROM SelectedTorrents")]
    errors = [error_row(r) for r in db.execute("SELECT * FROM ErroredTorrents")]
    last_event = db.execute("SELECT MAX(OccurredAt) FROM Events").fetchone()[0]
    migration = db.execute("SELECT MAX(MigrationId) FROM __EFMigrationsHistory").fetchone()[0] \
        if "__EFMigrationsHistory" in db.tables else None
    path = database_path(args)
    stats = {
        "database": os.path.abspath(path),
        "database_size": os.path.getsize(path),
        "schema": migration,
        "torrents": len(torrents),
        "by_status": tally("status"),
        "by_media_type": tally("media_type"),
        "by_library": tally("library"),
        "linked_files": sum(t["files"] for t in torrents),
        "linked_size": sum(t["linked_size"] or 0 for t in torrents),
        "mismatched": sum(1 for t in torrents if t["mismatch"]),
        "not_in_client": sum(1 for t in torrents if t["client_status"] == NOT_IN_CLIENT),
        "queued": sum(1 for s in selected if s["state"] == "queued"),
        "downloading": sum(1 for s in selected if s["state"] == "downloading"),
        "errors": {stage: sum(1 for e in errors if e["stage"] == stage) for stage in ERROR_STAGES},
        "duplicates": db.execute("SELECT COUNT(*) FROM DuplicateTorrents").fetchone()[0],
        "events": db.execute("SELECT COUNT(*) FROM Events").fetchone()[0],
        "last_event": iso(parse_time(last_event)),
        "lists": db.execute("SELECT COUNT(*) FROM Lists").fetchone()[0] if "Lists" in db.tables else 0,
    }
    if out.format in ("json", "jsonl"):
        print(json.dumps(stats, indent=2 if out.format == "json" else None, ensure_ascii=False))
        return EXIT_OK

    flat = []
    for key, value in stats.items():
        if isinstance(value, dict):
            flat.extend((f"{key}.{k}", v) for k, v in value.items())
        else:
            flat.append((key, value))
    if out.format == "table":
        width = max(len(k) for k, _ in flat)
        for key, value in flat:
            if key.endswith("_size") and isinstance(value, int):
                value = f"{human_size(value)} ({value} bytes)"
            print(f"{key.ljust(width)}  {'' if value is None else value}")
    elif out.format == "csv":
        writer = csv.writer(sys.stdout, lineterminator="\n")
        if not args.no_header:
            writer.writerow(["key", "value"])
        writer.writerows(flat)
    else:
        out.write_lines([f"{k}\t{'' if v is None else v}" for k, v in flat])
    return EXIT_OK


def cmd_sql(db, args, out):
    try:
        cursor = db.execute(" ".join(args.query))
    except sqlite3.Error as error:
        raise UsageError(f"sql: {error}")
    names = [d[0] for d in cursor.description or []]
    if not names:
        return EXIT_EMPTY
    available = {n: Column(n, "str", n, True) for n in names}
    rows = [dict(zip(names, r)) for r in cursor.fetchall()]
    return out.emit(rows, available, names, None, id_column=names[0])


