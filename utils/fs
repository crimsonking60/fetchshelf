def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    group = common.add_argument_group("common options")
    group.add_argument("--db", metavar="FILE", default=argparse.SUPPRESS,
                       help="database file (default: $FETCHSHELF_DB, then $FETCHSHELF_DATA_FILE, then ./data.db)")
    group.add_argument("-f", "--format", choices=FORMATS, default=argparse.SUPPRESS,
                       help="output format (default: table on a terminal, tsv otherwise)")
    group.add_argument("--json", dest="format", action="store_const", const="json", default=argparse.SUPPRESS,
                       help="same as --format json")
    group.add_argument("-c", "--columns", metavar="LIST", default=argparse.SUPPRESS,
                       help="comma-separated columns to show, \"all\", or \"help\" to list them")
    group.add_argument("-q", "--ids", dest="ids_only", action="store_true", default=argparse.SUPPRESS,
                       help="print only each row's identifier (info-hash, path or MAM id), one per line")
    group.add_argument("-n", "--count", action="store_true", default=argparse.SUPPRESS,
                       help="print only the number of matching rows")
    group.add_argument("-s", "--sort", metavar="COLUMN", default=argparse.SUPPRESS, help="sort by this column")
    group.add_argument("-r", "--reverse", action="store_true", default=argparse.SUPPRESS, help="reverse the order")
    group.add_argument("-l", "--limit", metavar="N", type=int, default=argparse.SUPPRESS,
                       help="show at most N rows, after sorting")
    group.add_argument("--since", metavar="WHEN", default=argparse.SUPPRESS,
                       help="only rows from WHEN on: 2026-11-01, 2026-11-01T18:00, or 30m, 12h, 7d, 2w ago")
    group.add_argument("--until", metavar="WHEN", default=argparse.SUPPRESS, help="only rows before WHEN")
    group.add_argument("--header", action="store_true", default=argparse.SUPPRESS,
                       help="print a header line in tsv output")
    group.add_argument("--no-header", action="store_true", default=argparse.SUPPRESS,
                       help="leave out the header line in table and csv output")
    group.add_argument("-0", "--null", action="store_true", default=argparse.SUPPRESS,
                       help="end tsv and --ids lines with NUL instead of newline, for xargs -0")
    group.add_argument("-w", "--wide", action="store_true", default=argparse.SUPPRESS,
                       help="don't shorten table columns to fit the terminal")
    group.add_argument("--full-ids", action="store_true", default=argparse.SUPPRESS,
                       help="show whole info-hashes in tables, not the first 10 characters")
    group.add_argument("--path-map", metavar="FROM=TO", action="append", default=argparse.SUPPRESS,
                       help="rewrite paths starting with FROM to start with TO (repeatable), e.g. "
                            "/media=/srv/media when the database comes from a container")

    parser = argparse.ArgumentParser(
        prog="fs", parents=[common],
        description="Shows what a Fetchshelf installation knows, read straight from its database (read-only).",
        epilog="Run 'fs COMMAND --help' for a command's own options. Exit status: 0 when something was found, "
               "1 when nothing matched, 2 on errors. See docs/fs.md.")
    commands = parser.add_subparsers(dest="command", metavar="COMMAND")

    def add(name, function, help_text, aliases=()):
        sub = commands.add_parser(name, parents=[common], help=help_text, description=help_text, aliases=list(aliases))
        sub.set_defaults(function=function)
        return sub

    def torrent_filters(sub):
        f = sub.add_argument_group("filters (repeat an option or separate values with commas to allow several)")
        f.add_argument("query", nargs="*", help="text in the title, authors, narrators, series or info-hash")
        f.add_argument("--status", action="append", metavar="STATUS",
                       help=f"{', '.join(TORRENT_STATUSES)}, or not-linked for all but linked")
        f.add_argument("--problem", action="append", metavar="PROBLEM", help="any, mismatch or not-in-client")
        f.add_argument("--library", action="append", metavar="NAME", help="library name")
        f.add_argument("--category", action="append", metavar="NAME", help="qBittorrent category")
        f.add_argument("--media-type", action="append", metavar="TYPE", help="e.g. audiobook, ebook, manga")
        f.add_argument("--language", action="append", metavar="LANGUAGE", help="e.g. English")
        f.add_argument("--author", metavar="TEXT", help="text in an author's name")
        f.add_argument("--series", metavar="TEXT", help="text in a series name")

    torrent_filters(add("torrents", cmd_torrents, "list torrents Fetchshelf has a record of", ["t"]))

    sub = add("torrent", cmd_torrent, "show everything about one torrent", ["show"])
    sub.add_argument("torrent", help="info-hash, a unique prefix of it (4+ characters), mam:<id>, or a MAM id")

    sub = add("files", cmd_files, "list the files linked into the libraries")
    torrent_filters(sub)
    sub.add_argument("--missing", action="store_true", help="only files that are not on disk")
    sub.add_argument("--present", action="store_true", help="only files that are on disk")

    sub = add("events", cmd_events, "show the event log, newest first", ["log"])
    sub.add_argument("query", nargs="*", help="text in the title, details or info-hash")
    sub.add_argument("--kind", action="append", metavar="KIND", help=", ".join(EVENT_KINDS))
    sub.add_argument("--torrent", metavar="ID", help="only this torrent's events (info-hash, prefix or MAM id)")

    sub = add("selected", cmd_selected, "show the download queue", ["queue"])
    sub.add_argument("query", nargs="*", help="text in the title or authors")
    sub.add_argument("--state", action="append", metavar="STATE",
                     help="queued, downloading, removed, or all (default: queued,downloading)")
    sub.add_argument("--grabber", action="append", metavar="NAME", help="autograb or list that selected it")

    sub = add("errors", cmd_errors, "show the errors on the Errors page, newest first")
    sub.add_argument("--stage", action="append", metavar="STAGE", help=", ".join(ERROR_STAGES))

    add("duplicates", cmd_duplicates, "show torrents skipped as duplicates, newest first", ["dupes"])

    add("lists", cmd_lists, "show the Hardcover lists")

    sub = add("list-items", cmd_list_items, "show the books on the lists, in list order", ["books"])
    sub.add_argument("query", nargs="*", help="text in the title, authors or series")
    sub.add_argument("--list", metavar="ID", help="only this list (its id, or the end of it, e.g. want_to_read)")
    sub.add_argument("--status", action="append", metavar="STATUS",
                     help="selected, wanted, not-wanted, existing, not-found, or none (not looked for); "
                          "matches either format")
    sub.add_argument("--all", action="store_true", help="include books marked done or no longer on the list")

    add("stats", cmd_stats, "summarise the installation", ["summary"])

    sub = add("sql", cmd_sql, "run a read-only SQL query against the database")
    sub.add_argument("query", nargs="+", help="the query, e.g. \"SELECT Title FROM Torrents LIMIT 5\"")
    return parser


DEFAULTS = {"db": None, "format": None, "columns": None, "ids_only": False, "count": False, "sort": None,
            "reverse": False, "limit": None, "since": None, "until": None, "header": False, "no_header": False,
            "null": False, "wide": False, "full_ids": False, "path_map": None}


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    for key, value in DEFAULTS.items():
        if not hasattr(args, key):
            setattr(args, key, value)
    if not getattr(args, "function", None):
        parser.print_help(sys.stderr)
        return EXIT_ERROR
    try:
        args.since = parse_bound(args.since, "--since") if args.since else None
        args.until = parse_bound(args.until, "--until") if args.until else None
        if args.limit is not None and args.limit < 0:
            raise UsageError("--limit: must be 0 or more")
        out = Output(args)
        db = open_database(args)
        try:
            return args.function(db, args, out)
        finally:
            db.close()
    except UsageError as error:
        print(f"fs: {error}", file=sys.stderr)
        return EXIT_ERROR
    except BrokenPipeError:
        # The reader went away (fs ... | head); stop quietly.
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
        return EXIT_OK
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
