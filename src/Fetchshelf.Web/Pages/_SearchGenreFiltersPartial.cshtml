@model Fetchshelf.Web.Pages.IndexModel
@* The Fiction and Genre filters, at the top of the results' filter box. Like the filters below them they hide rows of this
   page in the browser, from each row's genres and main category: MAM is asked nothing, and the count below the results
   says how many are hidden. *@
@if (Model.GenresOn)
{
    <div id="search-genre-filters">
        <span>Show only:</span>
        <select id="search-fiction" aria-label="Fiction">
            <option value="">Fiction or not</option>
            @foreach (var (value, label) in Fetchshelf.Web.Pages.IndexModel.FictionOptions)
            {
                <option value="@value">@label</option>
            }
        </select>
        <select id="search-genre" aria-label="Genre">
            <option value="">Any genre</option>
            @foreach (var (value, label) in Fetchshelf.Web.Pages.IndexModel.GenreOptions)
            {
                <option value="@value">@label</option>
            }
        </select>
    </div>
}
