@model Fetchshelf.Web.Pages.IndexModel

@if (Model.SearchError is not null)
{
    <p id="search-error" class="notice error">
        Search failed: @Model.SearchError
        <button type="button" hx-get="@Url.Page("/Index", "Results", Model.SearchRouteValues())" hx-target="#search-results-panel" hx-swap="innerHTML" hx-indicator="#search-loading">Try again</button>
    </p>
}
else if (Model.ResultsLoaded && Model.Results.Count == 0)
{
    <p id="no-results-message" class="empty">No results.@(Model.SnatchedLeftOut > 0 ? $" {Model.SnatchedLeftOut} on this page were left out as snatched before." : "")</p>
    @await Html.PartialAsync("_SearchPagerPartial", Model)
}
else
{
    @if (Model.ResultsLoaded)
    {
        @* Sent with every Download click on the page; the category qBittorrent gets, and with it the library. *@
        <div class="toolbar" id="download-category-bar">
            <label>Download into
                <select id="download-category" name="category">
                    <option value="">the category the tag rules give</option>
                    @foreach (var (value, label) in Model.CategoryOptions)
                    {
                        <option value="@value" selected="@(value == Model.ChosenCategory)">@label</option>
                    }
                </select>
            </label>
        </div>
    }
    @* Right above the table they narrow; the page's script keeps their state when the results arrive. *@
    <div id="search-filters">
        <label>
            <input type="checkbox" id="hide-downloaded" />
            Hide downloaded torrents
        </label>
        <span id="media-filter">
            Show:
            <label class="show-filter-all show-filter-active" data-media-filter="All">
                <input type="radio" name="MediaFilter" value="All" checked class="visually-hidden" />
                All
            </label>
            <label class="show-filter-ebooks" data-media-filter="Ebooks">
                <input type="radio" name="MediaFilter" value="Ebooks" class="visually-hidden" />
                Ebooks
            </label>
            <label class="show-filter-audiobooks" data-media-filter="Audiobooks">
                <input type="radio" name="MediaFilter" value="Audiobooks" class="visually-hidden" />
                Audiobooks
            </label>
            <label class="show-filter-comic" data-media-filter="Comics">
                <input type="radio" name="MediaFilter" value="Comics" class="visually-hidden" />
                Comics
            </label>
            <label class="show-filter-other" data-media-filter="Other">
                <input type="radio" name="MediaFilter" value="Other" class="visually-hidden" />
                Other
            </label>
        </span>
    </div>
    @* Before the results arrive this renders as just the header row, so the spinner has a table to sit over. *@
    <table id="search-results">
        <thead>
            <tr>
                <th>Title</th>
                <th>Authors</th>
                <th>Media type</th>
                <th>Quality</th>
                <th>Status</th>
                <th>Size</th>
                <th>Cost</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var result in Model.Results)
            {
                @await Html.PartialAsync("_SearchResultRowPartial", (result, false))
            }
        </tbody>
    </table>
    @if (Model.ResultsLoaded)
    {
        @await Html.PartialAsync("_SearchPagerPartial", Model)
    }
}
