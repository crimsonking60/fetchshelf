@page
@model Fetchshelf.Web.Pages.Selected.IndexModel
@{
    ViewData["Title"] = "Selected";
}

<h2>Selected</h2>
@await Html.PartialAsync("_PageExplanation", "This page is the download queue: torrents Fetchshelf has picked and is about to send to qBittorrent, or has sent and is still downloading. A torrent leaves the queue once it has finished; the Torrents page follows it from there. Adjust a selection's cost, category or tags before it starts and press Update on its row, or tick one or more selections and use Remove selected if you no longer want them.")

@if (Model.Selections.Count == 0)
{
    <p id="no-selections-message" class="empty">No torrents are selected.</p>
}
else
{
    @* Each row's Update has its own form (referenced by the inputs' and button's form attribute) so one row can be saved
       on its own; they sit outside the bulk-remove form below because forms cannot nest. Only rows still waiting to
       download get one: cost, category and tags are used when the torrent is added to qBittorrent, so once a row has
       started, editing them would change nothing. *@
    @foreach (var selection in Model.Selections.Where(s => s.StartedAt is null))
    {
        <form id="update-@selection.Id" method="post" asp-page-handler="Update">@Html.AntiForgeryToken()</form>
    }

    <form method="post" asp-page-handler="RemoveSelected">
        @Html.AntiForgeryToken()
        <table>
            <thead>
                <tr>
                    <th><input type="checkbox" aria-label="Select all" onclick="document.querySelectorAll('.selection-select').forEach(c => c.checked = this.checked)" /></th>
                    <th>Title</th>
                    <th>Cost</th>
                    <th>Category</th>
                    <th>Tags</th>
                    <th>Grabber</th>
                    <th>Created</th>
                    <th>Started</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var selection in Model.Selections)
                {
                    <tr>
                        <td><input class="selection-select" type="checkbox" name="selectedIds" value="@selection.Id" aria-label="Select @selection.Title" /></td>
                        <td>@selection.Title</td>
                        @if (selection.StartedAt is null)
                        {
                            <td>
                                <select form="update-@selection.Id" name="cost" aria-label="Cost for @selection.Title">
                                    @foreach (var cost in Fetchshelf.Web.Pages.Selected.IndexModel.CostChoicesFor(selection))
                                    {
                                        <option value="@cost" selected="@(cost == selection.CostDecision)">@cost</option>
                                    }
                                </select>
                            </td>
                            <td>
                                <input form="update-@selection.Id" type="hidden" name="id" value="@selection.Id" />
                                <input form="update-@selection.Id" type="text" name="category" value="@selection.Category" />
                            </td>
                            <td><input form="update-@selection.Id" type="text" name="tags" value="@string.Join(",", selection.Tags)" /></td>
                        }
                        else
                        {
                            <td class="nowrap">@selection.CostDecision</td>
                            <td>@(string.IsNullOrEmpty(selection.Category) ? "-" : selection.Category)</td>
                            <td>@(selection.Tags.Count == 0 ? "-" : string.Join(", ", selection.Tags))</td>
                        }
                        <td>@selection.GrabberName</td>
                        <td><local-time value="selection.CreatedAt" /></td>
                        <td><local-time value="selection.StartedAt" /></td>
                        <td>
                            @if (selection.StartedAt is null)
                            {
                                <button form="update-@selection.Id" type="submit">Update</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="actions">
            <button type="submit" class="danger">Remove selected</button>
        </div>
    </form>
}
