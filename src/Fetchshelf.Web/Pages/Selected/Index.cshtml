@page
@model Fetchshelf.Web.Pages.Selected.IndexModel
@{
    ViewData["Title"] = "Selected";
}

<h2>Selected</h2>
@await Html.PartialAsync("_PageExplanation", "This page is the download queue: torrents Fetchshelf has picked and is about to send to qBittorrent. Adjust a selection's category or tags before it starts, or remove it if you no longer want it.")

@if (Model.Selections.Count == 0)
{
    <p id="no-selections-message" class="empty">No torrents are selected.</p>
}
else
{
    @foreach (var selection in Model.Selections)
    {
        <form id="update-@selection.Id" method="post" asp-page-handler="Update">@Html.AntiForgeryToken()</form>
        <form id="remove-@selection.Id" method="post" asp-page-handler="Remove">@Html.AntiForgeryToken()</form>
    }
    <table>
        <thead>
            <tr>
                <th>Title</th>
                <th>Cost</th>
                <th>Category</th>
                <th>Tags</th>
                <th>Grabber</th>
                <th>Created</th>
                <th>Started</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var selection in Model.Selections)
            {
                <tr>
                    <td>@selection.Title</td>
                    <td>@selection.CostDecision</td>
                    <td>
                        <input form="update-@selection.Id" type="hidden" name="id" value="@selection.Id" />
                        <input form="update-@selection.Id" type="text" name="category" value="@selection.Category" />
                    </td>
                    <td><input form="update-@selection.Id" type="text" name="tags" value="@string.Join(",", selection.Tags)" /></td>
                    <td>@selection.GrabberName</td>
                    <td>@selection.CreatedAt</td>
                    <td>@(selection.StartedAt?.ToString() ?? "-")</td>
                    <td>
                        <button form="update-@selection.Id" type="submit">Update</button>
                        <input form="remove-@selection.Id" type="hidden" name="id" value="@selection.Id" />
                        <button form="remove-@selection.Id" type="submit" class="danger">Remove</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
