<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fetchshelf</title>
    <script src="~/lib/htmx/htmx.min.js"></script>
</head>
<body>
    <header>
        <h1><a asp-area="" asp-page="/Index">Fetchshelf</a></h1>
        <nav>
            <a asp-page="/Index">Search</a>
            <a asp-page="/Jobs/Index">Jobs</a>
            <a asp-page="/Selected/Index">Selected</a>
            <a asp-page="/Torrents/Index">Torrents</a>
            <a asp-page="/Events/Index">Events</a>
            <a asp-page="/Errors/Index">Errors</a>
            <a asp-page="/Lists/Index">Lists</a>
            <a asp-page="/Config/Index">Config</a>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
