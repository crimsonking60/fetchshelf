@{
    var theme = Themes.Resolve(Context.Request.Cookies[Themes.CookieName]);
    var currentPage = (string?)ViewContext.RouteData.Values["page"] ?? "";

    // Search lives at /Index; every other nav entry owns the folder it points into (Torrents/Detail keeps "Torrents" lit).
    bool IsCurrent(string navPage) =>
        navPage == "/Index"
            ? currentPage == "/Index"
            : currentPage.StartsWith(navPage[..(navPage.LastIndexOf('/') + 1)], StringComparison.Ordinal);

    var navItems = new List<(string Page, string Label)>
    {
        ("/Index", "Search"),
        ("/Jobs/Index", "Jobs"),
    };
    // Only of use with a MAM account to read; the page itself stays reachable either way.
    if (Settings.BackgroundJobsEnabled)
    {
        navItems.Add(("/Account/Index", "Account"));
    }

    navItems.AddRange(
    [
        ("/Selected/Index", "Selected"),
        ("/Torrents/Index", "Torrents"),
        ("/Series/Index", "Series"),
    ]);
    // Only of use with a [follow] section; the page itself says so when there is none.
    if (Settings.Follow is not null)
    {
        navItems.Add(("/Following/Index", "Following"));
    }

    navItems.AddRange(
    [
        ("/Events/Index", "Events"),
        ("/Errors/Index", "Errors"),
        ("/Duplicates/Index", "Duplicates"),
    ]);
    // Only of use to those who follow Hardcover lists; the page itself stays reachable either way.
    if (Settings.HardcoverList.Count > 0)
    {
        navItems.Add(("/Lists/Index", "Lists"));
    }

    navItems.Add(("/Config/Index", "Config"));
}
<!DOCTYPE html>
<html lang="en" data-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fetchshelf</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <link rel="preload" href="~/lib/fonts/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/fonts.css" />
    <link rel="stylesheet" href="~/css/themes.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <script src="~/lib/htmx/htmx.min.js"></script>
    <script src="~/js/theme.js" defer></script>
    <script src="~/js/errors.js" defer></script>
    <script src="~/js/local-time.js" defer></script>
</head>
<body>
    @if (Settings.DevelopmentBanner)
    {
        <div class="development-banner" aria-hidden="true"></div>
    }
    <header class="site-header">
        <h1 class="brand">
            <a asp-area="" asp-page="/Index">
                <svg width="22" height="20" viewBox="0 0 22 20" aria-hidden="true">
                    <rect class="spine-a" x="0" y="4" width="6" height="16" rx="1.2" />
                    <rect class="spine-b" x="8" y="0" width="6" height="20" rx="1.2" />
                    <rect class="spine-c" x="16" y="6" width="6" height="14" rx="1.2" />
                </svg>
                Fetchshelf
            </a>
        </h1>
        <nav class="site-nav" aria-label="Main">
            @foreach (var (navPage, label) in navItems)
            {
                <a asp-page="@navPage" aria-current="@(IsCurrent(navPage) ? "page" : null)">@label@if (navPage == "/Errors/Index")
                    {
                        @await Component.InvokeAsync("ErrorBadge")
                    }
                    else if (navPage == "/Following/Index")
                    {
                        @await Component.InvokeAsync("FollowBadge")
                    }</a>
            }
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
    @* At the end of every page: the version on the left, which bug reports quote, and the theme on the right. *@
    <footer class="site-footer">
        <div class="site-footer-row">
            <span id="site-version">Fetchshelf version @AppVersion.Current</span>
            <form class="theme-switcher" method="get" action="/theme">
                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                <label for="theme-select">Theme</label>
                <select id="theme-select" name="name" data-theme-select>
                    @foreach (var (id, themeLabel) in Themes.All)
                    {
                        <option value="@id" selected="@(id == theme)">@themeLabel</option>
                    }
                </select>
                <noscript><button type="submit">Apply</button></noscript>
            </form>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
