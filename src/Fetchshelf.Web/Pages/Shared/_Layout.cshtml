@{
    var theme = Themes.Resolve(Context.Request.Cookies[Themes.CookieName]);
}
<!DOCTYPE html>
<html lang="en" data-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fetchshelf</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <link rel="preload" href="~/lib/fonts/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/fonts.css" />
    <link rel="stylesheet" href="~/css/themes.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <script src="~/lib/htmx/htmx.min.js"></script>
    <script src="~/js/theme.js" defer></script>
    <script src="~/js/nav.js" defer></script>
    <script src="~/js/bulk-bar.js" defer></script>
    <script src="~/js/run-status.js" defer></script>
    <script src="~/js/keys.js" defer></script>
    <script src="~/js/errors.js" defer></script>
    <script src="~/js/local-time.js" defer></script>
</head>
<body>
    @if (Settings.DevelopmentBanner)
    {
        <div class="development-banner" aria-hidden="true"></div>
    }
    <header class="site-header">
        <h1 class="brand">
            <a asp-area="" asp-page="/Index">
                <svg width="22" height="20" viewBox="0 0 22 20" aria-hidden="true">
                    <rect class="spine-a" x="0" y="4" width="6" height="16" rx="1.2" />
                    <rect class="spine-b" x="8" y="0" width="6" height="20" rx="1.2" />
                    <rect class="spine-c" x="16" y="6" width="6" height="14" rx="1.2" />
                </svg>
                Fetchshelf
            </a>
        </h1>
        @await Component.InvokeAsync("MainNav")
    </header>
    <main>
        @RenderBody()
    </main>
    @* At the end of every page: the version, which bug reports quote. The theme is chosen in the menu bar. *@
    <footer class="site-footer">
        <div class="site-footer-row">
            <span id="site-version">Fetchshelf version @AppVersion.Current</span>
            @* The keys work through keys.js; without a script the list is still a fair map of the pages. *@
            <details id="shortcuts" class="shortcuts">
                <summary>Keyboard shortcuts <kbd>?</kbd></summary>
                <ul>
                    <li><kbd>/</kbd> the search box of the page (Search, Torrents, Series)</li>
                    <li><kbd>g</kbd> then <kbd>t</kbd> <a asp-page="/Torrents/Index" data-go="t">Torrents</a></li>
                    <li><kbd>g</kbd> then <kbd>j</kbd> <a asp-page="/Jobs/Index" data-go="j">Jobs</a></li>
                    <li><kbd>g</kbd> then <kbd>s</kbd> <a asp-page="/Selected/Index" data-go="s">Selected</a></li>
                    <li><kbd>g</kbd> then <kbd>e</kbd> <a asp-page="/Errors/Index" data-go="e">Errors</a></li>
                    <li><kbd>g</kbd> then <kbd>h</kbd> <a asp-page="/Index" data-go="h">Search (home)</a></li>
                    <li><kbd>?</kbd> this list</li>
                </ul>
            </details>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
