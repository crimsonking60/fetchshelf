@model Fetchshelf.Web.Pages.PagerViewModel

<p class="muted">
    Showing @Model.ShownCount of @Model.TotalCount. Page @Model.PageNumber of @Model.TotalPages.
    @if (Model.ShowsPageSizes)
    {
        @* Not a form field (the list can sit inside a bulk-action form): choosing a size opens the first page at that size. *@
        <label>
            Per page
            <select id="@(Model.Id)-size" onchange="location.href = this.value">
                @foreach (var (size, label) in Fetchshelf.Web.Pages.Paging.PageSizeOptions)
                {
                    <option value="@Url.Page(Model.Page, Model.RouteValuesForPageSize(size).ToDictionary(p => p.Key, p => (object?)p.Value))" selected="@(Model.PageSize == size)">@label</option>
                }
            </select>
        </label>
    }
</p>

@if (Model.TotalPages > 1)
{
    <nav id="@Model.Id" class="actions" aria-label="@Model.Label">
        @if (Model.PageNumber > 1)
        {
            <a id="pager-first" asp-page="@Model.Page" asp-all-route-data="Model.RouteValuesFor(1)">First</a>
            <a id="pager-prev" asp-page="@Model.Page" asp-all-route-data="Model.RouteValuesFor(Model.PageNumber - 1)">Previous</a>
        }
        @if (Model.PageNumber < Model.TotalPages)
        {
            <a id="pager-next" asp-page="@Model.Page" asp-all-route-data="Model.RouteValuesFor(Model.PageNumber + 1)">Next</a>
            <a id="pager-last" asp-page="@Model.Page" asp-all-route-data="Model.RouteValuesFor(Model.TotalPages)">Last</a>
        }
    </nav>
}
