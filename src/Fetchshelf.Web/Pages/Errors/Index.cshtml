@page
@model Fetchshelf.Web.Pages.Errors.IndexModel
@{
    ViewData["Title"] = "Errors";
}

<h2>Errors</h2>
@await Html.PartialAsync("_PageExplanation", "Problems Fetchshelf ran into, one row per torrent and job. Link tries a failed torrent again on every run: its row is updated while it keeps failing and disappears once it links. A download whose link went stale is taken out of the download queue instead; Retry download puts it back on the Selected page. Tick the rows you have dealt with and use Remove selected.")

@if (Model.Errors.Count == 0)
{
    <p id="no-errors-message" class="empty">No errors.</p>
}
else
{
    @* Retry has its own form per row (referenced by the button's form attribute) because forms cannot nest inside the
       bulk-remove form below. *@
    @foreach (var error in Model.Errors.Where(e => e.CanRestore))
    {
        <form id="restore-@error.Id" method="post" asp-page-handler="Restore">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@error.Id" />
        </form>
    }

    <form method="post" asp-page-handler="RemoveSelected">
        @Html.AntiForgeryToken()
        <table>
            <thead>
                <tr>
                    <th><input type="checkbox" aria-label="Select all" onclick="document.querySelectorAll('.error-select').forEach(c => c.checked = this.checked)" /></th>
                    <th>Job</th>
                    <th>Torrent</th>
                    <th>Error</th>
                    <th>Last failed</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var error in Model.Errors)
                {
                    var name = error.Title ?? "(unknown torrent)";
                    <tr>
                        <td><input class="error-select" type="checkbox" name="selectedIds" value="@error.Id" aria-label="Select @name" /></td>
                        <td class="nowrap">@error.Job</td>
                        <td>
                            @if (error.TorrentDetailId is not null)
                            {
                                <a asp-page="/Torrents/Detail" asp-route-id="@error.TorrentDetailId">@name</a>
                            }
                            else
                            {
                                @name
                            }
                            <div class="muted mono">@error.KeyLabel @error.Key</div>
                        </td>
                        <td>@error.ErrorText</td>
                        <td><local-time value="error.OccurredAt" /></td>
                        <td>
                            @if (error.CanRestore)
                            {
                                <button form="restore-@error.Id" type="submit" class="nowrap">Retry download</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="actions">
            <button type="submit" class="danger">Remove selected</button>
        </div>
    </form>
}
