@page
@model Fetchshelf.Web.Pages.Torrents.IndexModel
@{
    ViewData["Title"] = "Torrents";
}

<h2>Torrents</h2>
@await Html.PartialAsync("_PageExplanation", "This page lists every torrent Fetchshelf is tracking. Search, filter, sort by a column heading, or select several at once to clean, refresh, relink, unlink, remove them or set their category in bulk. Click a torrent's title to see its details, files and events, and to act on it, for example relink, unlink, or change its category and tags in qBittorrent. Check qBittorrent asks the client for the current state of every tracked torrent and updates the Status column.")

<div class="toolbar-bar">
    @* A changed dropdown applies straight away; the button is for the search text. *@
    <form method="get" class="toolbar-stack">
        <div class="toolbar search-line">
            <input type="text" name="Q" value="@Model.Q" placeholder="Search title, author, series" aria-label="Search" />
            <button type="submit" class="primary">Search</button>
        </div>
        @* The filters fold away behind one line, which stays open while any is in use, or when it was left open
           (remember-open.js keeps that in a cookie); the chips say which are in use, and each drops its own. *@
        <details class="filter-panel" open="@Model.FiltersOpen" data-remember-open="@IndexModel.FiltersOpenCookie">
        <summary><span>Filters</span>@if (Model.FilterChips.Count > 0)
            {
                <span class="nav-badge" title="Filters in use">@Model.FilterChips.Count</span>
            }</summary>
        <div class="toolbar">
            <select name="Status" aria-label="Status" onchange="this.form.requestSubmit()">
                <option value="">Any status</option>
                @foreach (var (value, label) in TorrentListFilters.StatusOptions)
                {
                    <option value="@value" selected="@(Model.Status == value)">@label</option>
                }
            </select>
            <select name="Library" aria-label="Library" onchange="this.form.requestSubmit()">
                <option value="">Any library</option>
                @foreach (var library in Model.LibraryOptions)
                {
                    <option value="@library" selected="@(Model.Library == library)">@library</option>
                }
            </select>
            <select name="QbCategory" aria-label="qBittorrent category" onchange="this.form.requestSubmit()">
                <option value="">Any qBittorrent category</option>
                @foreach (var category in Model.QbCategoryOptions)
                {
                    <option value="@category" selected="@(Model.QbCategory == category)">@category</option>
                }
            </select>
            <select name="Problem" aria-label="Problems" onchange="this.form.requestSubmit()">
                <option value="">Problems or not</option>
                @foreach (var (value, label) in TorrentListFilters.ProblemOptions)
                {
                    <option value="@value" selected="@(Model.Problem == value)">@label</option>
                }
            </select>
            @if (Model.SeedingRequirement is not null)
            {
                <select name="Seeding" aria-label="Seeding" onchange="this.form.requestSubmit()">
                    <option value="">Seeding or not</option>
                    @foreach (var (value, label) in TorrentListFilters.SeedingOptions)
                    {
                        <option value="@value" selected="@(Model.Seeding == value)">@label</option>
                    }
                </select>
            }
            @if (Model.HasCollectionBooks || !string.IsNullOrEmpty(Model.CollectionBooks))
            {
                <select name="CollectionBooks" aria-label="Books of collections" onchange="this.form.requestSubmit()" title="A split collection's books show as their own rows only when chosen here, or when the search, or an author, narrator or series, looks for them.">
                    <option value="">Collections as one row</option>
                    <option value="@Pages.Torrents.IndexModel.ShowCollectionBooks" selected="@(Model.CollectionBooks == Pages.Torrents.IndexModel.ShowCollectionBooks)">Books of collections too</option>
                </select>
            }
            <select name="MediaType" aria-label="Media type" onchange="this.form.requestSubmit()">
                <option value="">Any media type</option>
                @foreach (var mediaType in Model.MediaTypeOptions)
                {
                    <option value="@mediaType" selected="@(Model.MediaType == mediaType)">@mediaType</option>
                }
            </select>
            <select name="Language" aria-label="Language" onchange="this.form.requestSubmit()">
                <option value="">Any language</option>
                @foreach (var language in Model.LanguageOptions)
                {
                    <option value="@language" selected="@(Model.Language == language)">@language</option>
                }
            </select>
            @if (Model.GenresOn)
            {
                <select name="Fiction" aria-label="Fiction" onchange="this.form.requestSubmit()">
                    <option value="">Fiction or not</option>
                    @foreach (var (value, label) in Model.FictionOptions)
                    {
                        <option value="@value" selected="@(Model.Fiction == value)">@label</option>
                    }
                </select>
                <select name="Genre" aria-label="Genre" onchange="this.form.requestSubmit()">
                    <option value="">Any genre</option>
                    @foreach (var (value, label) in Model.GenreOptions)
                    {
                        <option value="@value" selected="@(Model.Genre == value)">@label</option>
                    }
                </select>
            }
            @if (Model.Query.HasFilters)
            {
                <a id="clear-filters" asp-page="/Torrents/Index"
                   asp-all-route-data="Model.Query.WithoutFilters().ToRouteValues()">Clear filters</a>
            }
        </div>
        </details>
        @if (Model.FilterChips.Count > 0)
        {
            <div class="toolbar">
                @foreach (var chip in Model.FilterChips)
                {
                    <span class="name-filter">@chip.Label: @chip.Value
                        <a asp-page="/Torrents/Index" asp-all-route-data="chip.Without.ToRouteValues()" aria-label="Stop filtering by @chip.Label.ToLowerInvariant()">&times;</a></span>
                }
            </div>
        }
        @* Author, narrator and series are filtered by following a name's link; each shows here with a way to drop it. *@
        @if (Model.NameFilters.Count > 0)
        {
            <div class="toolbar">
                @foreach (var filter in Model.NameFilters)
                {
                    <input type="hidden" name="@filter.Parameter" value="@filter.Key" />
                    <span class="name-filter">@filter.Label: @filter.Name
                        <a asp-page="/Torrents/Index" asp-all-route-data="filter.Without.ToRouteValues()" aria-label="Stop filtering by @filter.Label.ToLowerInvariant()">&times;</a></span>
                }
            </div>
        }
        <input type="hidden" name="Sort" value="@Model.Sort" />
        <input type="hidden" name="Dir" value="@Model.Dir" />
        <input type="hidden" name="PageSize" value="@Model.PageSize" />
    </form>

    @* One group, so it moves below the search form as a whole when the open filters leave no room beside them. *@
    <div class="toolbar list-actions push">
        @* Asks qBittorrent about every tracked torrent (not just this page) and swaps in the refreshed list, keeping the current filters, sort and page. *@
        <form method="post" asp-page-handler="CheckClient"
              hx-post="@Url.Page("/Torrents/Index", "CheckClient")" hx-target="#torrent-list-body" hx-swap="innerHTML"
              hx-indicator="#torrent-loading" hx-disabled-elt="find button">
            @Html.AntiForgeryToken()
            @foreach (var (name, value) in Model.Query.ToRouteValues())
            {
                <input type="hidden" name="@name" value="@value" />
            }
            <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
            <button type="submit">Check qBittorrent</button>
        </form>

        @* Every page of the list as it is searched, filtered and sorted now. *@
        <div class="toolbar" id="export-links">
            Export:
            <a asp-page="/Torrents/Index" asp-page-handler="Export" asp-all-route-data='Model.ExportRouteValues("csv")'>CSV</a>
            <a asp-page="/Torrents/Index" asp-page-handler="Export" asp-all-route-data='Model.ExportRouteValues("json")'>JSON</a>
            @* The same choice as under the list, so a long list's size can be changed without scrolling to its end. *@
            @if (Model.Pager.ShowsPageSizes)
            {
                <span class="page-size-top"><partial name="_PageSize" model='Model.Pager with { Id = "torrent-pager-top" }' /></span>
            }
        </div>
    </div>
</div>

@* Outside the filter form: a form can't hold another. *@
@if (Settings.Follow is not null && Model.NameFilters.Any(f => f.Parameter != nameof(Model.Narrator)))
{
    var returnUrl = Model.Request.Path + Model.Request.QueryString;
    <div class="toolbar" id="follow-buttons">
        @foreach (var filter in Model.NameFilters.Where(f => f.Parameter != nameof(Model.Narrator)))
        {
            var kind = filter.Parameter == nameof(Model.Series) ? Fetchshelf.Data.Entities.FollowKind.Series : Fetchshelf.Data.Entities.FollowKind.Author;
            <partial name="/Pages/Following/_FollowButtons.cshtml" model="new Fetchshelf.Web.Pages.Following.FollowButtonsViewModel(kind, [new NameLink(filter.Name, filter.Key)], Model.Followed, returnUrl)" />
        }
    </div>
}

@await Html.PartialAsync("_BulkOperationsPartial", Model.BulkOperations)

@* With htmx the post swaps in only the progress panel (or the list, for Remove), so the ticks and the scroll stay. *@
<form method="post" asp-page-handler="Bulk"
      hx-post="@Url.Page("/Torrents/Index", "Bulk")" hx-target="#bulk-operations" hx-swap="outerHTML">
    @Html.AntiForgeryToken()
    @* So the list comes back with the same search, filters, sort and page after a bulk action. *@
    @foreach (var (name, value) in Model.Query.ToRouteValues())
    {
        <input type="hidden" name="@name" value="@value" />
    }
    <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
    <div class="results-wrap">
        <div id="torrent-list-body">
            @await Html.PartialAsync("_TorrentListPartial", Model)
        </div>
        <div id="torrent-loading" class="loading-overlay htmx-indicator" role="status">
            <div class="loading-chip">
                <span class="spinner" aria-hidden="true"></span>
                <span>Checking qBittorrent…</span>
            </div>
        </div>
    </div>
</form>
