@page
@model Fetchshelf.Web.Pages.Torrents.IndexModel
@{
    ViewData["Title"] = "Torrents";
}

<h2>Torrents</h2>
@await Html.PartialAsync("_PageExplanation", "This page lists every torrent Fetchshelf is tracking. Search, filter, sort by title, or select several at once to clean, refresh, relink, unlink, or remove them in bulk. Click a torrent's title to see its details, files and events, and to act on it, for example relink, unlink, or change its category and tags in qBittorrent. Check qBittorrent asks the client for the current state of every tracked torrent and updates the Client status column.")

<div class="toolbar-bar">
    @* A changed dropdown applies straight away; the button is for the search text. *@
    <form method="get" class="toolbar">
        <input type="text" name="Q" value="@Model.Q" placeholder="Search title, author, series" aria-label="Search" />
        <button type="submit">Search</button>
        <select name="Status" aria-label="Status" onchange="this.form.requestSubmit()">
            <option value="">Any status</option>
            @foreach (var (value, label) in TorrentListFilters.StatusOptions)
            {
                <option value="@value" selected="@(Model.Status == value)">@label</option>
            }
        </select>
        <select name="Library" aria-label="Library" onchange="this.form.requestSubmit()">
            <option value="">Any library</option>
            @foreach (var library in Model.LibraryOptions)
            {
                <option value="@library" selected="@(Model.Library == library)">@library</option>
            }
        </select>
        <select name="Problem" aria-label="Problems" onchange="this.form.requestSubmit()">
            <option value="">Problems or not</option>
            @foreach (var (value, label) in TorrentListFilters.ProblemOptions)
            {
                <option value="@value" selected="@(Model.Problem == value)">@label</option>
            }
        </select>
        <select name="MediaType" aria-label="Media type" onchange="this.form.requestSubmit()">
            <option value="">Any media type</option>
            @foreach (var mediaType in Model.MediaTypeOptions)
            {
                <option value="@mediaType" selected="@(Model.MediaType == mediaType)">@mediaType</option>
            }
        </select>
        <select name="Language" aria-label="Language" onchange="this.form.requestSubmit()">
            <option value="">Any language</option>
            @foreach (var language in Model.LanguageOptions)
            {
                <option value="@language" selected="@(Model.Language == language)">@language</option>
            }
        </select>
        <input type="hidden" name="Sort" value="@Model.Sort" />
        <input type="hidden" name="Dir" value="@Model.Dir" />
        <input type="hidden" name="PageSize" value="@Model.PageSize" />
        @if (Model.Query.HasFilters)
        {
            <a id="clear-filters" asp-page="/Torrents/Index"
               asp-all-route-data="(Model.Query with { Status = null, Library = null, Problem = null, Language = null, MediaType = null }).ToRouteValues()">Clear filters</a>
        }
    </form>

    @* Asks qBittorrent about every tracked torrent (not just this page) and swaps in the refreshed list, keeping the current filters, sort and page. *@
    <form method="post" asp-page-handler="CheckClient" class="push"
          hx-post="@Url.Page("/Torrents/Index", "CheckClient")" hx-target="#torrent-list-body" hx-swap="innerHTML"
          hx-indicator="#torrent-loading" hx-disabled-elt="find button">
        @Html.AntiForgeryToken()
        @foreach (var (name, value) in Model.Query.ToRouteValues())
        {
            <input type="hidden" name="@name" value="@value" />
        }
        <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
        <button type="submit">Check qBittorrent</button>
    </form>
</div>

<form method="post" asp-page-handler="Bulk">
    @Html.AntiForgeryToken()
    @* So the list comes back with the same search, filters, sort and page after a bulk action. *@
    @foreach (var (name, value) in Model.Query.ToRouteValues())
    {
        <input type="hidden" name="@name" value="@value" />
    }
    <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
    <div class="results-wrap">
        <div id="torrent-list-body">
            @await Html.PartialAsync("_TorrentListPartial", Model)
        </div>
        <div id="torrent-loading" class="loading-overlay htmx-indicator" role="status">
            <div class="loading-chip">
                <span class="spinner" aria-hidden="true"></span>
                <span>Checking qBittorrent…</span>
            </div>
        </div>
    </div>
</form>
