@page "{id}"
@model Fetchshelf.Web.Pages.Torrents.DetailModel
@using Fetchshelf.Core.Organizer
@{
    ViewData["Title"] = "Torrent detail";
}

@if (Model.Torrent is { } torrent)
{
    <h2>@torrent.Metadata.Title</h2>
    @if (torrent.MamLink is not null || torrent.AbsLink is not null)
    {
        <p class="torrent-links">
            @if (torrent.MamLink is not null)
            {
                <a id="mam-link" href="@torrent.MamLink" target="_blank" rel="noreferrer">Open on MAM</a>
            }
            @if (torrent.AbsLink is not null)
            {
                <a id="abs-link" href="@torrent.AbsLink" target="_blank">Open in Audiobookshelf</a>
            }
        </p>
    }
    @if (Model.ActionMessage is { } actionMessage)
    {
        <p id="action-message" class="notice@(Model.ActionFailed ? " error" : "")" role="@(Model.ActionFailed ? "alert" : "status")">@actionMessage</p>
    }
    @* Refresh and relink runs in the background: how far it has got, and how it went, until dismissed. *@
    @await Html.PartialAsync("_BulkOperationsPartial", Model.BulkOperations)
    @await Html.PartialAsync("_PageExplanation", "This page shows everything Fetchshelf knows about this torrent: its metadata, linked files, qBittorrent state, and history. Use the actions below to clean, refresh, relink, unlink, or remove it. While qBittorrent has the torrent you can also change its category and tags there.")
    @if (Model.Collection is var (collectionId, collectionTitle))
    {
        <p id="collection-of" class="notice">
            A book of the collection <a asp-page="/Torrents/Detail" asp-route-id="@collectionId">@collectionTitle</a>, linked as a book of its own.
            qBittorrent has the collection's torrent, which its other books share: its category, tags, <strong>Start</strong>,
            <strong>Stop</strong> and removal are on the collection's page. <strong>Refresh</strong> and <strong>Refresh and
            relink</strong> act on the whole collection.
        </p>
    }
    else if (Model.IsBook)
    {
        <p id="collection-of" class="notice">A book of a collection whose record is gone; Refresh and relink brings the collection back.</p>
    }

    @if (Model.Books.Count > 0)
    {
        <p id="collection-books" class="notice">
            A collection, linked as its @Model.Books.Count books: each has its own page, folder and record. Clean, Unlink and
            Relink act on a book; <strong>Refresh and relink</strong> here relinks them all.
        </p>
        <table id="books">
            <thead><tr><th>Book</th><th>Folder</th></tr></thead>
            <tbody>
                @foreach (var book in Model.Books)
                {
                    <tr><td><a asp-page="/Torrents/Detail" asp-route-id="@book.Id">@book.Title</a></td><td class="break">@(book.LibraryPath ?? "not linked")</td></tr>
                }
            </tbody>
        </table>
    }

    <div class="meta-block">
        <p><span class="label">Authors</span><span class="value"><partial name="_NameLinks" model="new NameLinksViewModel(NameLink.Authors(torrent.Metadata), nameof(IndexModel.Author))" /></span></p>
        <p><span class="label">Narrators</span><span class="value"><partial name="_NameLinks" model="new NameLinksViewModel(NameLink.Narrators(torrent.Metadata), nameof(IndexModel.Narrator))" /></span></p>
        <p><span class="label">Series</span><span class="value"><partial name="_NameLinks" model="new NameLinksViewModel(NameLink.Series(torrent.Metadata), nameof(IndexModel.Series))" /></span></p>
        @if (Settings.Follow is not null)
        {
            var returnUrl = Model.Request.Path + Model.Request.QueryString;
            @* A div, not a p: a browser ends a p where a form starts, which would spill the buttons out of their row. *@
            <div id="follow-buttons"><span class="label">Follow</span><span class="value">
                <partial name="/Pages/Following/_FollowButtons.cshtml" model="new Fetchshelf.Web.Pages.Following.FollowButtonsViewModel(Fetchshelf.Data.Entities.FollowKind.Series, NameLink.Series(torrent.Metadata), Model.Followed, returnUrl)" />
                <partial name="/Pages/Following/_FollowButtons.cshtml" model="new Fetchshelf.Web.Pages.Following.FollowButtonsViewModel(Fetchshelf.Data.Entities.FollowKind.Author, NameLink.Authors(torrent.Metadata), Model.Followed, returnUrl)" />
            </span></div>
        }
        @if (Model.UpgradeNote is { } upgradeNote)
        {
            @* The Search page, which looks in titles and authors by default, for the title and first author as plain words,
               in the book's own language. *@
            var searchText = Fetchshelf.Core.AutoDownloader.ListMamQueryBuilder.PlainWords(
                string.Join(' ', new[] { torrent.Metadata.Title, torrent.Metadata.Authors.FirstOrDefault() }.OfType<string>()));
            <p id="upgrade-note"><span class="label">Format</span><span class="value">@upgradeNote.
                <a asp-page="/Index" asp-route-Q="@searchText" asp-route-Lang="@torrent.Metadata.Language">Look for a better copy</a></span></p>
        }
        <p><span class="label">Language</span><span class="value">@torrent.Metadata.Language</span></p>
        <p><span class="label">Media type</span><span class="value">@torrent.Metadata.MediaType</span></p>
        @if (Model.GenresOn)
        {
            var fiction = torrent.Metadata.FictionCategory;
            var genres = torrent.Metadata.GenreCategories.OrderBy(Fetchshelf.Core.Metadata.GenreLabels.Label, StringComparer.OrdinalIgnoreCase).ToList();
            <p id="main-category"><span class="label">Main category</span><span class="value">@if (fiction is { } main)
                {
                    <a asp-page="/Torrents/Index" asp-route-Fiction="@main.ToString()">@Fetchshelf.Core.Metadata.GenreLabels.FictionLabel(main)</a>
                }
                else
                {
                    <text>-</text>
                }</span></p>
            <p id="genres"><span class="label">Genres</span><span class="value">@if (genres.Count == 0)
                {
                    <text>-</text>
                }
                @for (var i = 0; i < genres.Count; i++)
                {
                    <text>@(i > 0 ? ", " : "")<a asp-page="/Torrents/Index" asp-route-Genre="@GenreFilters.ValueOf(genres[i])">@Fetchshelf.Core.Metadata.GenreLabels.Label(genres[i])</a></text>
                }</span></p>
        }
        <p><span class="label">Metadata source</span><span class="value">@torrent.Metadata.MetadataSource</span></p>
        <p><span class="label">Library path</span><span class="value mono">@(torrent.LibraryPath ?? "-")</span></p>
    </div>
    @if (torrent.LibraryMismatchState == nameof(Fetchshelf.Core.Organizer.LibraryMismatchState.NoLibrary) && torrent.LibraryPath is null)
    {
        <p id="mismatch-state" class="notice">Not linked: no library accepts this torrent's qBittorrent category, save path or tags. Give it one of your libraries' categories, here or with <strong>Set category</strong> on the Torrents page, and the next Link run links it.</p>
    }
    else if (torrent.LibraryMismatchState is not null)
    {
        <p id="mismatch-state" class="notice">Library mismatch: @LibraryMismatchLabel.For(torrent.LibraryMismatchState)</p>
    }
    @if (torrent.ReplacedWithTorrentId is not null)
    {
        <p id="replaced-marker" class="notice">Replaced with: <a asp-page="/Torrents/Detail" asp-route-id="@torrent.ReplacedWithTorrentId">@torrent.ReplacedWithTorrentId</a></p>
    }
    @if (torrent.UnlinkedAt is { } unlinkedAt)
    {
        <p id="unlinked-marker" class="notice">Unlinked <local-time value="unlinkedAt" />. The Link job leaves it alone; Refresh and relink links it again.</p>
    }
    @if (torrent.RemovedFromMamAt is { } removedFromMamAt)
    {
        <p id="removed-from-mam" class="notice">MAM no longer has this torrent (found <local-time value="removedFromMamAt" />). It keeps seeding and stays linked; what to do with it is up to you.</p>
    }
    @if (Model.Seeding is { } seedingEstimate && Model.SeedingRequirement is { } seedingRequirement)
    {
        <p id="seeding-state" class="@(seedingEstimate.State == Fetchshelf.Core.Organizer.SeedingState.Satisfied ? "" : "notice")">
            @Fetchshelf.Core.Organizer.SeedingEstimator.Describe(seedingEstimate, seedingRequirement)
            <span class="muted">An estimate from qBittorrent's seeding time; the Account page has MAM's own counts.</span>
        </p>
    }
    <h3>Linked files</h3>
    <ul>
        @foreach (var file in torrent.LinkedFiles)
        {
            <li><span class="mono">@file.RelativePath</span> <span class="muted" title="@file.SizeBytes.ToString("N0", System.Globalization.CultureInfo.InvariantCulture) bytes">(@Fetchshelf.Core.AutoDownloader.DownloadBudget.FormatBytes(file.SizeBytes))</span></li>
        }
    </ul>

    @if (torrent.ClientState is { } state)
    {
        <h3>qBittorrent state</h3>
        <p>Progress: @(state.Progress * 100)% - State: <span title="@state.State">@QBittorrentStateLabel.For(state.State)</span></p>
        <p>Category: @state.Category - Tags: @string.Join(", ", state.TagList)</p>

        @if (!Model.IsBook)
        {
            @* Untick a tag to remove it; add new ones, separated by commas. *@
            <form id="category-tags-form" method="post" asp-page-handler="SetCategoryAndTags" asp-route-id="@torrent.Id" class="edit-form">
                @Html.AntiForgeryToken()
                <label>Category @await Html.PartialAsync("_LibraryCategorySelect", new LibraryCategorySelectViewModel(Model.CategoryOptions, state.Category, "category-select"))</label>
                @if (state.TagList.Count > 0)
                {
                    <fieldset>
                        <legend>Tags</legend>
                        @foreach (var tag in state.TagList)
                        {
                            <label><input type="checkbox" name="tags" value="@tag" checked /> @tag</label>
                        }
                    </fieldset>
                }
                <label>Add tags <input type="text" name="newTags" placeholder="Separate tags with commas" /></label>
                <button type="submit" class="primary">Set category and tags</button>
            </form>
        }
    }

    <h3>Actions</h3>
    @* One row per action: the button, and what it does beside it (under it on a narrow screen). Each form is display:
       contents, so its button and note are cells of the grid and the notes line up. *@
    <div class="action-list">
        @if (Model.Books.Count == 0)
        {
            <form method="post" asp-page-handler="Clean" asp-route-id="@torrent.Id">
                @Html.AntiForgeryToken()
                <button type="submit">Clean</button>
                <div class="action-note">Looks for another linked copy of this book and retires the worse of the two, which can be this one. Does nothing when no other copy is linked.</div>
            </form>
        }
        @if (Model.EditedByHand)
        {
            <form method="post" asp-page-handler="Refresh" asp-route-id="@torrent.Id" data-confirm="Replace the details edited by hand with the details from MAM? Refresh and relink keeps the edits instead." data-confirm-label="Replace">
                @Html.AntiForgeryToken()
                <button type="submit">Refresh</button>
                <div class="action-note">Replaces the details with MAM's, including the ones edited by hand, without moving any files. Asks first.</div>
            </form>
        }
        else
        {
            <form method="post" asp-page-handler="Refresh" asp-route-id="@torrent.Id">
                @Html.AntiForgeryToken()
                <button type="submit">Refresh</button>
                <div class="action-note">Replaces the details with MAM's, without moving any files.</div>
            </form>
        }
        <form method="post" asp-page-handler="RefreshAndRelink" asp-route-id="@torrent.Id">
            @Html.AntiForgeryToken()
            <button type="submit" class="primary" disabled="@Model.RefreshAndRelinkQueued" title="@(Model.RefreshAndRelinkQueued ? "Waiting or running; its progress is shown at the top of the page" : null)">Refresh and relink</button>
            <div class="action-note">
                @if (Model.OffersSplit)
                {
                    <input type="hidden" name="splitShown" value="true" />
                    <label class="action-option" title="When it is a collection, link it as one book each. Starts as its library's split_collections; what you choose here is kept for this torrent."><input type="checkbox" name="split" value="true" checked="@Model.Splits" /> Split into its books <span class="action-option-hint">links each book of a collection on its own</span></label>
                }
                Updates the details from MAM, keeping the ones edited by hand, and moves the book's folder to match them. Also brings back a book that was unlinked or replaced. Runs in the background, with its progress at the top of the page.
            </div>
        </form>
        @if (torrent.UnlinkedAt is null && Model.Books.Count == 0)
        {
            <form method="post" asp-page-handler="Unlink" asp-route-id="@torrent.Id" data-confirm="@(Model.RemovalWarning + "Remove this book from your library? qBittorrent keeps the torrent and its data, and Fetchshelf stops linking it until you relink it.")" data-confirm-label="Remove">
                @Html.AntiForgeryToken()
                <button type="submit">Unlink</button>
                <div class="action-note">Takes the book out of the library. qBittorrent keeps seeding it, and the record stays, so it isn't downloaded again. Asks first.</div>
            </form>
        }
        @if (!Model.IsBook)
        {
            <form method="post" asp-page-handler="Start" asp-route-id="@torrent.Id">
                @Html.AntiForgeryToken()
                <button type="submit">Start</button>
                <div class="action-note">Starts the torrent in qBittorrent.</div>
            </form>
            <form method="post" asp-page-handler="Stop" asp-route-id="@torrent.Id">
                @Html.AntiForgeryToken()
                <button type="submit">Stop</button>
                <div class="action-note">Stops the torrent in qBittorrent.</div>
            </form>
            <form method="post" asp-page-handler="RemoveWithData" asp-route-id="@torrent.Id" data-confirm="@(Model.RemovalWarning + "Remove this torrent from qBittorrent and delete its downloaded files? This cannot be undone.")" data-confirm-label="Remove">
                @Html.AntiForgeryToken()
                <button type="submit" class="danger">Remove from qBittorrent with data</button>
                <div class="action-note">Removes the torrent from qBittorrent and deletes its downloaded files. This cannot be undone. Asks first.</div>
            </form>
        }
        @if (torrent.ReplacedWithTorrentId is not null)
        {
            <form method="post" asp-page-handler="ClearReplaced" asp-route-id="@torrent.Id">
                @Html.AntiForgeryToken()
                <button type="submit">Clear replaced marker</button>
                <div class="action-note">Forgets that a better copy replaced this one, so the next Link run links it again. While the better copy is linked, the next Clean retires it again.</div>
            </form>
        }
        <form method="post" asp-page-handler="RemoveRecord" asp-route-id="@torrent.Id">
            @Html.AntiForgeryToken()
            <button type="submit" class="danger">Remove record</button>
            <div class="action-note">Makes Fetchshelf forget this torrent, and a collection's books with it. Files are left as they are; the next Link run takes the torrent up again while qBittorrent has it and a library accepts it.</div>
        </form>
    </div>
    <p><a asp-page="/Torrents/Edit" asp-route-id="@torrent.Id">Edit metadata</a></p>

    <h3>Events</h3>
    <ul>
        @foreach (var e in torrent.Events)
        {
            <li><local-time value="e.OccurredAt" /> - @Fetchshelf.Web.Pages.Events.EventLabels.For(e.Kind)@(e.EditedByHand == true ? " (by hand)" : "")</li>
        }
    </ul>
}
else
{
    <p class="empty">Torrent not found.</p>
}
