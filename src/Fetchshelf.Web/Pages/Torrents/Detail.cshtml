@page "{id}"
@model Fetchshelf.Web.Pages.Torrents.DetailModel
@using Fetchshelf.Core.Organizer
@{
    ViewData["Title"] = "Torrent detail";
}

@if (Model.Torrent is { } torrent)
{
    <h2>@torrent.Metadata.Title</h2>
    @if (Model.ActionMessage is { } actionMessage)
    {
        <p id="action-message" class="notice@(Model.ActionFailed ? " error" : "")" role="@(Model.ActionFailed ? "alert" : "status")">@actionMessage</p>
    }
    @await Html.PartialAsync("_PageExplanation", "This page shows everything Fetchshelf knows about this torrent: its metadata, linked files, qBittorrent state, and history. Use the actions below to clean, refresh, relink, unlink, or remove it. While qBittorrent has the torrent you can also change its category and tags there.")
    <div class="meta-block">
        <p><span class="label">Authors</span><span class="value"><partial name="_NameLinks" model="new NameLinksViewModel(NameLink.Authors(torrent.Metadata), nameof(IndexModel.Author))" /></span></p>
        <p><span class="label">Narrators</span><span class="value"><partial name="_NameLinks" model="new NameLinksViewModel(NameLink.Narrators(torrent.Metadata), nameof(IndexModel.Narrator))" /></span></p>
        <p><span class="label">Series</span><span class="value"><partial name="_NameLinks" model="new NameLinksViewModel(NameLink.Series(torrent.Metadata), nameof(IndexModel.Series))" /></span></p>
        <p><span class="label">Language</span><span class="value">@torrent.Metadata.Language</span></p>
        <p><span class="label">Media type</span><span class="value">@torrent.Metadata.MediaType</span></p>
        <p><span class="label">Metadata source</span><span class="value">@torrent.Metadata.MetadataSource</span></p>
        <p><span class="label">Library path</span><span class="value mono">@(torrent.LibraryPath ?? "-")</span></p>
    </div>
    @if (torrent.LibraryMismatchState == nameof(Fetchshelf.Core.Organizer.LibraryMismatchState.NoLibrary) && torrent.LibraryPath is null)
    {
        <p id="mismatch-state" class="notice">Not linked: no library accepts this torrent's qBittorrent category, save path or tags. Give it one of your libraries' categories, here or with <strong>Set category</strong> on the Torrents page, and the next Link run links it.</p>
    }
    else if (torrent.LibraryMismatchState is not null)
    {
        <p id="mismatch-state" class="notice">Library mismatch: @LibraryMismatchLabel.For(torrent.LibraryMismatchState)</p>
    }
    @if (torrent.ReplacedWithTorrentId is not null)
    {
        <p id="replaced-marker" class="notice">Replaced with: <a asp-page="/Torrents/Detail" asp-route-id="@torrent.ReplacedWithTorrentId">@torrent.ReplacedWithTorrentId</a></p>
    }
    @if (torrent.UnlinkedAt is { } unlinkedAt)
    {
        <p id="unlinked-marker" class="notice">Unlinked <local-time value="unlinkedAt" />. The Link job leaves it alone; Refresh and relink links it again.</p>
    }
    @if (torrent.RemovedFromMamAt is { } removedFromMamAt)
    {
        <p id="removed-from-mam" class="notice">MAM no longer has this torrent (found <local-time value="removedFromMamAt" />). It keeps seeding and stays linked; what to do with it is up to you.</p>
    }
    @if (torrent.MamLink is not null)
    {
        <p id="mam-link"><a href="@torrent.MamLink" target="_blank" rel="noreferrer">Open on MAM</a></p>
    }
    @if (torrent.AbsLink is not null)
    {
        <p id="abs-link"><a href="@torrent.AbsLink" target="_blank">Open in Audiobookshelf</a></p>
    }

    <h3>Linked files</h3>
    <ul>
        @foreach (var file in torrent.LinkedFiles)
        {
            <li><span class="mono">@file.RelativePath</span> <span class="muted">(@file.SizeBytes bytes)</span></li>
        }
    </ul>

    @if (torrent.ClientState is { } state)
    {
        <h3>qBittorrent state</h3>
        <p>Progress: @(state.Progress * 100)% - State: <span title="@state.State">@QBittorrentStateLabel.For(state.State)</span></p>
        <p>Category: @state.Category - Tags: @string.Join(", ", state.TagList)</p>

        @* Untick a tag to remove it; add new ones, separated by commas. *@
        <form id="category-tags-form" method="post" asp-page-handler="SetCategoryAndTags" asp-route-id="@torrent.Id" class="edit-form">
            @Html.AntiForgeryToken()
            <label>Category @await Html.PartialAsync("_LibraryCategorySelect", new LibraryCategorySelectViewModel(Model.CategoryOptions, state.Category, "category-select"))</label>
            @if (state.TagList.Count > 0)
            {
                <fieldset>
                    <legend>Tags</legend>
                    @foreach (var tag in state.TagList)
                    {
                        <label><input type="checkbox" name="tags" value="@tag" checked /> @tag</label>
                    }
                </fieldset>
            }
            <label>Add tags <input type="text" name="newTags" placeholder="Separate tags with commas" /></label>
            <button type="submit">Set category and tags</button>
        </form>
    }

    <h3>Actions</h3>
    <div class="actions">
        <form method="post" asp-page-handler="Clean" asp-route-id="@torrent.Id">@Html.AntiForgeryToken()<button type="submit">Clean</button></form>
        <form method="post" asp-page-handler="Refresh" asp-route-id="@torrent.Id">@Html.AntiForgeryToken()<button type="submit">Refresh</button></form>
        <form method="post" asp-page-handler="RefreshAndRelink" asp-route-id="@torrent.Id">@Html.AntiForgeryToken()<button type="submit">Refresh and relink</button></form>
        @if (torrent.UnlinkedAt is null)
        {
            <form method="post" asp-page-handler="Unlink" asp-route-id="@torrent.Id" onsubmit="return confirm('Remove this book from your library? qBittorrent keeps the torrent and its data, and Fetchshelf stops linking it until you relink it.')">@Html.AntiForgeryToken()<button type="submit">Unlink</button></form>
        }
        <form method="post" asp-page-handler="Start" asp-route-id="@torrent.Id">@Html.AntiForgeryToken()<button type="submit">Start</button></form>
        <form method="post" asp-page-handler="Stop" asp-route-id="@torrent.Id">@Html.AntiForgeryToken()<button type="submit">Stop</button></form>
        <form method="post" asp-page-handler="RemoveWithData" asp-route-id="@torrent.Id" onsubmit="return confirm('Remove this torrent from qBittorrent and delete its downloaded files? This cannot be undone.')">@Html.AntiForgeryToken()<button type="submit" class="danger">Remove from qBittorrent with data</button></form>
        @if (torrent.ReplacedWithTorrentId is not null)
        {
            <form method="post" asp-page-handler="ClearReplaced" asp-route-id="@torrent.Id">@Html.AntiForgeryToken()<button type="submit">Clear replaced marker</button></form>
        }
        <form method="post" asp-page-handler="RemoveRecord" asp-route-id="@torrent.Id">@Html.AntiForgeryToken()<button type="submit" class="danger">Remove record</button></form>
    </div>
    <p><a asp-page="/Torrents/Edit" asp-route-id="@torrent.Id">Edit metadata</a></p>

    <h3>Events</h3>
    <ul>
        @foreach (var e in torrent.Events)
        {
            <li><local-time value="e.OccurredAt" /> - @Fetchshelf.Web.Pages.Events.EventLabels.For(e.Kind)</li>
        }
    </ul>
}
else
{
    <p class="empty">Torrent not found.</p>
}
