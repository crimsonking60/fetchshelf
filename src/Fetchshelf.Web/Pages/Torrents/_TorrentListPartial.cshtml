@model Fetchshelf.Web.Pages.Torrents.IndexModel

@if (Model.CheckMessage is not null)
{
    <p id="check-message" class="notice@(Model.CheckFailed ? " error" : "")" role="@(Model.CheckFailed ? "alert" : "status")">@Model.CheckMessage</p>
}

@if (Model.Torrents.Count == 0)
{
    <p id="no-torrents-message" class="empty">No torrents found.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th><input type="checkbox" onclick="document.querySelectorAll('.torrent-select').forEach(c => c.checked = this.checked)" /></th>
                <th><a href="?Sort=Title&Dir=@(Model.Sort == "Title" && Model.Dir == "asc" ? "desc" : "asc")">Title</a></th>
                <th>Authors</th>
                <th>Series</th>
                <th>Media type</th>
                <th>Language</th>
                <th>Category</th>
                <th>Client status</th>
                <th>Mismatch</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var torrent in Model.Torrents)
            {
                <tr>
                    <td><input class="torrent-select" type="checkbox" name="selectedIds" value="@torrent.Id" /></td>
                    <td><a asp-page="/Torrents/Detail" asp-route-id="@torrent.Id">@torrent.Title</a></td>
                    <td>@torrent.Authors</td>
                    <td>@torrent.Series</td>
                    <td class="nowrap">@torrent.MediaType</td>
                    <td><a href="?Language=@torrent.Language">@torrent.Language</a></td>
                    <td>@torrent.QBittorrentCategory</td>
                    <td class="nowrap" title="@torrent.ClientStatus">@QBittorrentStateLabel.For(torrent.ClientStatus)</td>
                    <td>@(torrent.LibraryMismatchState ?? "-")</td>
                    <td class="nowrap"><a asp-page="/Torrents/Edit" asp-route-id="@torrent.Id">Edit</a></td>
                </tr>
            }
        </tbody>
    </table>

    <div class="actions">
        <button type="submit" name="action" value="clean">Clean selected</button>
        <button type="submit" name="action" value="refresh">Refresh selected</button>
        <button type="submit" name="action" value="removeRecord" class="danger">Remove selected</button>
    </div>

    <p class="muted">Showing @Model.Torrents.Count of @Model.TotalCount. Page @Model.PageNumber of @Model.TotalPages.</p>

    @if (Model.TotalPages > 1)
    {
        <nav id="torrent-pager" class="actions" aria-label="Torrent pages">
            @if (Model.PageNumber > 1)
            {
                <a id="pager-prev" asp-page="/Torrents/Index" asp-route-Q="@Model.Q" asp-route-Language="@Model.Language" asp-route-MediaType="@Model.MediaType"
                   asp-route-Sort="@Model.Sort" asp-route-Dir="@Model.Dir" asp-route-PageSize="@Model.PageSize" asp-route-PageNumber="@(Model.PageNumber - 1)">Previous</a>
            }
            @if (Model.PageNumber < Model.TotalPages)
            {
                <a id="pager-next" asp-page="/Torrents/Index" asp-route-Q="@Model.Q" asp-route-Language="@Model.Language" asp-route-MediaType="@Model.MediaType"
                   asp-route-Sort="@Model.Sort" asp-route-Dir="@Model.Dir" asp-route-PageSize="@Model.PageSize" asp-route-PageNumber="@(Model.PageNumber + 1)">Next</a>
            }
        </nav>
    }
}
