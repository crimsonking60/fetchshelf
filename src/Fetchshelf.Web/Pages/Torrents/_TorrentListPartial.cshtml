@model Fetchshelf.Web.Pages.Torrents.IndexModel
@using Fetchshelf.Core.Organizer

@if (Model.CheckMessage is not null)
{
    <p id="check-message" class="notice@(Model.CheckFailed ? " error" : "")" role="@(Model.CheckFailed ? "alert" : "status")">@Model.CheckMessage</p>
}

@if (Model.Torrents.Count == 0)
{
    <p id="no-torrents-message" class="empty">No torrents found.</p>
}
else
{
    @* One row per torrent, in six kinds of cell: authors and series sit under the title and the library mismatch inside the status, so the title gets the width. *@
    <table class="torrent-table">
        <thead>
            <tr>
                <th class="col-fit"><input type="checkbox" aria-label="Select all" onclick="document.querySelectorAll('.torrent-select').forEach(c => c.checked = this.checked)" /></th>
                <th sort-by="Title" sort-state="Model.Query.SortState" sort-page="/Torrents/Index" sort-route="Model.Query.ToRouteValues()">Title</th>
                <th class="col-fit" sort-by="Format" sort-state="Model.Query.SortState" sort-page="/Torrents/Index" sort-route="Model.Query.ToRouteValues()">Format</th>
                <th sort-by="Category" sort-state="Model.Query.SortState" sort-page="/Torrents/Index" sort-route="Model.Query.ToRouteValues()">Category</th>
                <th sort-by="Status" sort-state="Model.Query.SortState" sort-page="/Torrents/Index" sort-route="Model.Query.ToRouteValues()">Status</th>
                <th class="col-fit" sort-by="CreatedAt" sort-first-descending="true" sort-state="Model.Query.SortState" sort-page="/Torrents/Index" sort-route="Model.Query.ToRouteValues()">Added</th>
                <th class="col-fit"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var torrent in Model.Torrents)
            {
                <tr>
                    <td class="col-fit"><input class="torrent-select" type="checkbox" name="selectedIds" value="@torrent.Id" aria-label="Select @torrent.Title" /></td>
                    <td>
                        <a asp-page="/Torrents/Detail" asp-route-id="@torrent.Id">@torrent.Title</a>
                        @if (torrent.Unlinked)
                        {
                            <span class="muted">(unlinked)</span>
                        }
                        @if (torrent.CollectionTorrentId is { } collectionId)
                        {
                            <span class="muted">(from <a asp-page="/Torrents/Detail" asp-route-id="@collectionId">a collection</a>)</span>
                        }
                        else if (torrent.CollectionBookCount is { } bookCount)
                        {
                            <span class="muted">(collection of @bookCount books)</span>
                        }
                        @if (torrent.UpgradeNote is { } upgradeNote)
                        {
                            <span class="muted upgrade-note" title="A better format of this book is possible">(@upgradeNote)</span>
                        }
                        @if (torrent.Authors.Count > 0 || torrent.Series.Count > 0)
                        {
                            <div class="sub">
                                <partial name="_NameLinks" model="new NameLinksViewModel(torrent.Authors, nameof(IndexModel.Author), Model.Query)" />
                                @if (torrent.Authors.Count > 0 && torrent.Series.Count > 0)
                                {
                                    <span class="muted"> · </span>
                                }
                                <partial name="_NameLinks" model="new NameLinksViewModel(torrent.Series, nameof(IndexModel.Series), Model.Query)" />
                            </div>
                        }
                    </td>
                    <td class="col-fit"><a asp-page="/Torrents/Index" asp-all-route-data="(Model.Query with { MediaType = torrent.MediaType }).ToRouteValues()">@torrent.MediaType</a><div class="sub"><a asp-page="/Torrents/Index" asp-all-route-data="(Model.Query with { Language = torrent.Language }).ToRouteValues()">@torrent.Language</a></div></td>
                    <td class="col-clip" title="@torrent.QBittorrentCategory">@torrent.QBittorrentCategory</td>
                    <td class="col-fit">@QBittorrentStateLabel.For(torrent.ClientStatus)@if (torrent.RemovedFromMam)
                        {
                            <span class="muted">(removed from MAM)</span>
                        }@if (LibraryMismatchLabel.For(torrent.LibraryMismatchState) is { } mismatch)
                        {
                            <span class="status-badge status-not-in-qbittorrent" title="@torrent.LibraryMismatchState">@mismatch</span>
                        }@if (Model.SeedingNote(torrent) is { } seedingNote)
                        {
                            <div class="sub seeding-note">@seedingNote</div>
                        }</td>
                    <td class="col-fit" title="@torrent.CreatedAt.ToString("u")">@torrent.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td class="col-fit"><a asp-page="/Torrents/Edit" asp-route-id="@torrent.Id">Edit</a></td>
                </tr>
            }
        </tbody>
    </table>

    <div class="actions">
        <button type="submit" name="action" value="clean">Clean selected</button>
        <button type="submit" name="action" value="refresh">Refresh selected</button>
        <button type="submit" name="action" value="relink">Relink selected</button>
        <button type="submit" name="action" value="unlink"
                onclick="return confirm('Remove the selected books from your library? qBittorrent keeps the torrents and their data, and Fetchshelf stops linking them until you relink them.')">Unlink selected</button>
        <button type="submit" name="action" value="removeRecord" class="danger">Remove selected</button>
    </div>
    @if (Model.CategoryOptions.Count > 0)
    {
        <div class="actions">
            <label>Category for the selected torrents
                @await Html.PartialAsync("_LibraryCategorySelect", new LibraryCategorySelectViewModel(Model.CategoryOptions, null, "bulk-category", Placeholder: "Choose a category"))
            </label>
            <button type="submit" name="action" value="setCategory">Set category</button>
        </div>
    }

    @await Html.PartialAsync("_Pager", Model.Pager)
}
