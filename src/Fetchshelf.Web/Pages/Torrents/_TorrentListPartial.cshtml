@model Fetchshelf.Web.Pages.Torrents.IndexModel

@if (Model.CheckMessage is not null)
{
    <p id="check-message" class="notice@(Model.CheckFailed ? " error" : "")" role="@(Model.CheckFailed ? "alert" : "status")">@Model.CheckMessage</p>
}

@if (!string.IsNullOrEmpty(Model.Language) || !string.IsNullOrEmpty(Model.MediaType))
{
    <p id="active-filters" class="muted">
        Showing only:
        @if (!string.IsNullOrEmpty(Model.Language))
        {
            <span>language @Model.Language (<a asp-page="/Torrents/Index" asp-all-route-data="(Model.Query with { Language = null }).ToRouteValues()">show all</a>)</span>
        }
        @if (!string.IsNullOrEmpty(Model.MediaType))
        {
            <span>media type @Model.MediaType (<a asp-page="/Torrents/Index" asp-all-route-data="(Model.Query with { MediaType = null }).ToRouteValues()">show all</a>)</span>
        }
    </p>
}

@if (Model.Torrents.Count == 0)
{
    <p id="no-torrents-message" class="empty">No torrents found.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th><input type="checkbox" onclick="document.querySelectorAll('.torrent-select').forEach(c => c.checked = this.checked)" /></th>
                <th><a asp-page="/Torrents/Index" asp-all-route-data="Model.Query.ToggleTitleSort().ToRouteValues()">Title</a></th>
                <th>Authors</th>
                <th>Series</th>
                <th>Media type</th>
                <th>Language</th>
                <th>Category</th>
                <th>Client status</th>
                <th>Mismatch</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var torrent in Model.Torrents)
            {
                <tr>
                    <td><input class="torrent-select" type="checkbox" name="selectedIds" value="@torrent.Id" /></td>
                    <td><a asp-page="/Torrents/Detail" asp-route-id="@torrent.Id">@torrent.Title</a></td>
                    <td>@torrent.Authors</td>
                    <td>@torrent.Series</td>
                    <td class="nowrap"><a asp-page="/Torrents/Index" asp-all-route-data="(Model.Query with { MediaType = torrent.MediaType }).ToRouteValues()">@torrent.MediaType</a></td>
                    <td><a asp-page="/Torrents/Index" asp-all-route-data="(Model.Query with { Language = torrent.Language }).ToRouteValues()">@torrent.Language</a></td>
                    <td>@torrent.QBittorrentCategory</td>
                    <td class="nowrap" title="@torrent.ClientStatus">@QBittorrentStateLabel.For(torrent.ClientStatus)</td>
                    <td class="nowrap" title="@torrent.LibraryMismatchState">@(LibraryMismatchLabel.For(torrent.LibraryMismatchState) ?? "-")</td>
                    <td class="nowrap"><a asp-page="/Torrents/Edit" asp-route-id="@torrent.Id">Edit</a></td>
                </tr>
            }
        </tbody>
    </table>

    <div class="actions">
        <button type="submit" name="action" value="clean">Clean selected</button>
        <button type="submit" name="action" value="refresh">Refresh selected</button>
        <button type="submit" name="action" value="relink">Relink selected</button>
        <button type="submit" name="action" value="removeRecord" class="danger">Remove selected</button>
    </div>

    @await Html.PartialAsync("_Pager", Model.Pager)
}
