@page
@model Fetchshelf.Web.Pages.Books.IndexModel
@{
    ViewData["Title"] = "Books";
    var inList = Model.Heading is not null;
}

<h2>Books</h2>
@await Html.PartialAsync("_PageExplanation", "This page lists every book Fetchshelf has linked, audiobooks included, to find one and open it in the app that plays or shows it best: Audiobookshelf, or an OPDS reader for ebooks. The Torrents page is for managing the same books, and the Series page for completing series.")

@* The search runs on the button; the format, fiction and genre filters apply as soon as one is chosen, to whatever is shown. *@
<form method="get" class="toolbar-stack" id="books-search">
    <div class="toolbar search-line">
        <input type="text" name="Q" value="@Model.Q" placeholder="Search titles, authors and series" aria-label="Search" />
        <button type="submit" class="primary">Search</button>
    </div>
    <div class="toolbar" id="books-filters">
        <select name="Format" aria-label="Format" onchange="this.form.requestSubmit()">
            @foreach (var (value, label) in Fetchshelf.Web.Pages.Books.IndexModel.Formats)
            {
                <option value="@value" selected="@((Model.Format ?? string.Empty) == value)">@label</option>
            }
        </select>
        @if (Model.GenresOn)
        {
            <select name="Fiction" aria-label="Fiction" onchange="this.form.requestSubmit()">
                <option value="">Fiction or not</option>
                @foreach (var (value, label) in Model.FictionOptions)
                {
                    <option value="@value" selected="@(Model.Fiction == value)">@label</option>
                }
            </select>
            <select name="Genre" aria-label="Genre" onchange="this.form.requestSubmit()">
                <option value="">Any genre</option>
                @foreach (var (value, label) in Model.GenreOptions)
                {
                    <option value="@value" selected="@(Model.Genre == value)">@label</option>
                }
            </select>
        }
        @if (Model.HasFilters)
        {
            <a id="clear-filters" asp-page="/Books/Index" asp-all-route-data="Model.WithoutFilters">Clear filters</a>
        }
    </div>
    @* What is shown stays shown when a filter changes. *@
    @foreach (var (name, value) in Model.ShownRouteValues)
    {
        <input type="hidden" name="@name" value="@value" />
    }
    <input type="hidden" name="PageSize" value="@Model.PageSize" />
</form>

<nav class="book-views" aria-label="Views">
    @foreach (var (value, label) in Fetchshelf.Web.Pages.Books.IndexModel.Views)
    {
        var current = !inList && (Model.View ?? string.Empty) == value;
        <a id="view-@(value.Length == 0 ? "recent" : value)" class="book-view@(current ? " current" : "")" aria-current="@(current ? "page" : null)"
           asp-page="/Books/Index" asp-all-route-data="Model.RouteFor(nameof(Model.View), value)">@label</a>
    }
</nav>

@if (Model.Heading is { } heading)
{
    <h3 id="books-heading">@heading</h3>
    @if (Model.SeriesShown is { } series)
    {
        <p><a id="series-page-link" asp-page="/Series/Index" asp-route-Q="@series" asp-route-Show="all">This series on the Series page</a>, with its missing books.</p>
    }
}

@if (Model.LibraryEmpty)
{
    <p id="no-books-message" class="empty">No books yet. Books show up here once the Link job has placed them in a library.</p>
}
else if (Model.Groups is { } groups)
{
    @if (Model.View == Fetchshelf.Web.Pages.Books.IndexModel.ViewSeries)
    {
        var bySize = Model.Sort == Fetchshelf.Web.Pages.Books.IndexModel.SortBySize;
        var singlesShown = Model.Singles == Fetchshelf.Web.Pages.Books.IndexModel.ShowSingles;
        <p id="series-options" class="toolbar">
            <span>Sort:
                @if (bySize)
                {
                    <a id="series-sort-name" asp-page="/Books/Index" asp-all-route-data="Model.SeriesViewWith(nameof(Model.Sort), string.Empty)">A-Z</a>
                    <strong>Most books</strong>
                }
                else
                {
                    <strong>A-Z</strong>
                    <a id="series-sort-size" asp-page="/Books/Index" asp-all-route-data="Model.SeriesViewWith(nameof(Model.Sort), Fetchshelf.Web.Pages.Books.IndexModel.SortBySize)">Most books</a>
                }
            </span>
            @if (singlesShown)
            {
                <a id="series-singles" asp-page="/Books/Index" asp-all-route-data="Model.SeriesViewWith(nameof(Model.Singles), string.Empty)">Hide series with one book</a>
            }
            else if (Model.SinglesHidden > 0)
            {
                <span class="muted">@Model.SinglesHidden series with one book are hidden.</span>
                <a id="series-singles" asp-page="/Books/Index" asp-all-route-data="Model.SeriesViewWith(nameof(Model.Singles), Fetchshelf.Web.Pages.Books.IndexModel.ShowSingles)">Show them</a>
            }
        </p>
    }
    @if (groups.Count == 0)
    {
        <p id="no-books-message" class="empty">@(Model.SinglesHidden > 0 ? "Every series here has one book." : "Nothing in this format.")</p>
    }
    else
    {
        <ul id="book-groups" class="book-groups@(Model.View == Fetchshelf.Web.Pages.Books.IndexModel.ViewLibraries ? " single-column" : "")">
            @foreach (var group in groups)
            {
                <li><a asp-page="/Books/Index" asp-all-route-data="group.Route">@group.Name</a> <span class="muted">@group.BookCount @(group.BookCount == 1 ? "book" : "books")</span></li>
            }
        </ul>
        @await Html.PartialAsync("_Pager", Model.Pager)
    }
}
else if (Model.Books is { } books)
{
    @if (books.Count == 0)
    {
        <p id="no-books-message" class="empty">
            No books found.
            <a id="empty-clear-filters" asp-page="/Books/Index" asp-route-PageSize="@Model.PageSize">Show every book</a>
        </p>
    }
    else
    {
        <ul id="books" class="book-grid">
            @foreach (var book in books)
            {
                <li class="book-card">
                    <a class="book-open" href="@Url.Page("/Books/Detail", new { id = book.Id })"
                       hx-get="@Url.Page("/Books/Detail", "Partial", new { id = book.Id })" hx-target="#book-dialog-body" hx-swap="innerHTML">
                        <span class="book-cover" data-initial="@book.Initial">
                            @if (book.CoverHref is { } cover)
                            {
                                <img src="@cover" alt="" loading="lazy" />
                            }
                        </span>
                        <span class="book-title">@book.Title</span>
                    </a>
                    <span class="book-author muted">@book.ShownAuthors@if (book.HasMoreAuthors)
                    {
                        @* Opens the same book dialog as the cover, which lists every author. *@
                        <text> </text><a class="authors-more" href="@Url.Page("/Books/Detail", new { id = book.Id })"
                           hx-get="@Url.Page("/Books/Detail", "Partial", new { id = book.Id })" hx-target="#book-dialog-body" hx-swap="innerHTML"
                           aria-label="All @book.Authors.Count authors of @book.Title">... more</a>
                    }</span>
                    @if (book.SeriesLine is { } seriesLine)
                    {
                        <span class="book-series muted">@seriesLine</span>
                    }
                    <span class="book-formats">@foreach (var format in book.Formats)
                    {
                        <span class="status-badge">@format</span>
                    }</span>
                </li>
            }
        </ul>
        @await Html.PartialAsync("_Pager", Model.Pager)
    }
}

<dialog id="book-dialog" class="hit-dialog" aria-label="Book details">
    <div class="hit-dialog-bar">
        <button type="button" id="book-dialog-close">Close</button>
    </div>
    <div id="book-dialog-body"></div>
</dialog>
<script>
    (function () {
        const dialog = document.getElementById('book-dialog');
        const body = document.getElementById('book-dialog-body');
        document.body.addEventListener('htmx:beforeRequest', function (event) {
            if (event.detail.target === body) {
                body.innerHTML = '<p class="muted">Loading…</p>';
                if (!dialog.open) {
                    dialog.showModal();
                }
            }
        });
        document.getElementById('book-dialog-close').addEventListener('click', function () {
            dialog.close();
        });
        // A preview stops when the dialog closes, rather than playing on behind the page.
        dialog.addEventListener('close', function () {
            dialog.querySelectorAll('audio').forEach(function (audio) { audio.pause(); });
        });
        dialog.addEventListener('click', function (event) {
            if (event.target === dialog) {
                dialog.close();
            }
        });
        // A book without a cover after all shows its initial instead of a broken image.
        document.addEventListener('error', function (event) {
            if (event.target instanceof HTMLImageElement && event.target.closest('.book-cover')) {
                event.target.remove();
            }
        }, true);
    })();
</script>
