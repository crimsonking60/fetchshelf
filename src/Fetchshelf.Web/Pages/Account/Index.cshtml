@page
@model Fetchshelf.Web.Pages.Account.IndexModel
@using System.Globalization
@{
    ViewData["Title"] = "Account";
    var summary = Model.Summary;
    var account = summary.Snapshot?.State;
}

<h2>Account</h2>
@await Html.PartialAsync("_PageExplanation", "This page shows your MAM account's numbers as Fetchshelf last read them, and what Fetchshelf works out from them: how much it may still download, how many torrents it may still select, and how many wedges it may spend. When nothing is downloaded, the answer is usually here.")

@if (!Model.Configured)
{
    <p id="account-not-configured" class="empty">The auto-downloader isn't configured: set <code>mam_id</code> in config.toml to read your MAM account.</p>
    return;
}

@if (Model.BusyWith is { } busyWith)
{
    <p id="refresh-busy" class="notice" role="status">
        MAM is busy with <strong>@busyWith</strong>; try again when it is done.
        @if (summary.Snapshot is { } shown)
        {
            @:The numbers below are from <local-time value="shown.FetchedAt" />.
        }
    </p>
}
@if (Model.RefreshError is { } refreshError)
{
    <p id="refresh-error" class="notice error" role="alert">Could not read the account from MAM: @refreshError</p>
}

@if (summary.Pause is { } pause)
{
    <p id="mam-paused" class="notice error" role="alert">
        MAM calls are paused until <local-time value="pause.Until" />: @pause.Reason @pause.Advice
    </p>
}

<form method="post" asp-page-handler="Refresh" class="toolbar">
    <button type="submit">Refresh from MAM</button>
</form>

@if (account is null)
{
    <p id="no-account-read" class="empty">Nothing has been read from MAM since Fetchshelf started. Use <strong>Refresh from MAM</strong>, or wait for the next autograb or Download run.</p>
}
else
{
    @foreach (var warning in summary.Warnings)
    {
        <p class="notice error snatch-warning" role="alert">
            @warning.Label: @warning.Count. See your <a href="@summary.MamProfileUrl" rel="noreferrer">snatch lists on MAM</a>.
        </p>
    }

    <h3>From MAM</h3>
    <p class="muted">As of <local-time value="summary.Snapshot!.FetchedAt" />.</p>
    <table id="account-numbers" class="key-values">
        <tbody>
            @if (account.Username is not null || account.ClassName is not null)
            {
                <tr><th>Account</th><td>@string.Join(", ", new[] { account.Username, account.ClassName }.Where(v => !string.IsNullOrEmpty(v)))</td></tr>
            }
            <tr><th>Ratio</th><td>@account.Ratio.ToString("0.##", CultureInfo.InvariantCulture)</td></tr>
            <tr><th>Uploaded / Downloaded</th><td>@Fetchshelf.Core.AutoDownloader.DownloadBudget.FormatBytes(account.UploadedBytes) / @Fetchshelf.Core.AutoDownloader.DownloadBudget.FormatBytes(account.DownloadedBytes)</td></tr>
            <tr><th>Unsatisfied snatches</th><td>@account.UnsatCount of @account.UnsatLimit</td></tr>
            <tr><th>Wedges</th><td>@account.Wedges.ToString("N0", CultureInfo.InvariantCulture)</td></tr>
            @if (account.BonusPoints is { } bonus)
            {
                <tr><th>Bonus points</th><td>@bonus.ToString("N0", CultureInfo.InvariantCulture)</td></tr>
            }
        </tbody>
    </table>

    @if (summary.Snatches.Count > 0)
    {
        <h3>Snatches</h3>
        <table id="snatches">
            <thead>
                <tr><th>Kind</th><th>Count</th><th>Size</th></tr>
            </thead>
            <tbody>
                @foreach (var snatch in summary.Snatches)
                {
                    <tr>
                        <td>@snatch.Label</td>
                        <td>@snatch.Count.ToString("N0", CultureInfo.InvariantCulture)</td>
                        <td class="nowrap">@snatch.Size</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h3>What Fetchshelf works out from it</h3>
    <table id="derived-numbers" class="key-values">
        <tbody>
            @if (summary.RatioBudget is { } ratioBudget)
            {
                <tr>
                    <th>Ratio budget</th>
                    <td>@ratioBudget.Value<br /><span class="muted">@ratioBudget.Formula</span></td>
                </tr>
            }
            @foreach (var slots in summary.SelectionSlots)
            {
                <tr>
                    <th>Selection slots<br /><span class="muted">@slots.Label</span></th>
                    <td>@slots.Value<br /><span class="muted">@slots.Formula</span></td>
                </tr>
            }
            @foreach (var wedges in summary.Wedges)
            {
                <tr>
                    <th>Wedges to spend<br /><span class="muted">@wedges.Label</span></th>
                    <td>@wedges.Value<br /><span class="muted">@wedges.Formula</span></td>
                </tr>
            }
            <tr>
                <th>Queue</th>
                <td id="queue-forecast">
                    @summary.Queued waiting on the <a asp-page="/Selected/Index">Selected</a> page; the numbers above would let the Download job start @summary.Startable of them.
                </td>
            </tr>
        </tbody>
    </table>
}

<h3>Connection to MAM</h3>
<ul id="mam-connection">
    <li>
        @if (summary.LastSuccessAt is { } lastSuccess)
        {
            @:Last answered successfully <local-time value="lastSuccess" />.
        }
        else
        {
            @:MAM hasn't answered successfully since Fetchshelf started.
        }
    </li>
    @if (account?.Connectable is { } connectable)
    {
        <li>Connectable: @connectable</li>
    }
    @if (summary.LastRefusal is { } refusal)
    {
        <li>Last refusal, <local-time value="refusal.At" />: @refusal.Message</li>
    }
</ul>
