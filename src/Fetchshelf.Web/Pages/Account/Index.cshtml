@page
@model Fetchshelf.Web.Pages.Account.IndexModel
@using System.Globalization
@using Fetchshelf.Core.AutoDownloader
@{
    ViewData["Title"] = "Account";
    var summary = Model.Summary;
    var account = summary.Snapshot?.State;
}

<h2>Account</h2>
@await Html.PartialAsync("_PageExplanation", "This page shows the MAM account's numbers as Fetchshelf last read them, and what Fetchshelf works out from them: how much it may still download, how many torrents it may still select, and how many wedges it may spend. When nothing is downloaded, the answer is usually here.")

@if (!Model.Configured)
{
    <p id="account-not-configured" class="empty">The auto-downloader isn't configured: with <code>mam_id</code> set in config.toml, this page shows the MAM account.</p>
    return;
}

@if (Model.BusyWith is { } busyWith)
{
    <p id="refresh-busy" class="notice" role="status">
        MAM is busy with <strong>@busyWith</strong>; try again when it is done.
        @if (summary.Snapshot is { } shown)
        {
            <text>The numbers below are from <local-time value="shown.FetchedAt" />.</text>
        }
    </p>
}
@if (Model.RefreshError is { } refreshError)
{
    <p id="refresh-error" class="notice error" role="alert">Could not read the account from MAM: @refreshError</p>
}

@if (summary.Pause is { } pause)
{
    <p id="mam-paused" class="notice error" role="alert">
        MAM calls are paused until <local-time value="pause.Until" />: @pause.Reason @pause.Advice
    </p>
}

<form method="post" asp-page-handler="Refresh" class="toolbar">
    <button type="submit">Refresh from MAM</button>
</form>

@if (account is null)
{
    <p id="no-account-read" class="empty">Nothing has been read from MAM since Fetchshelf started. <strong>Refresh from MAM</strong> reads it now; the next autograb or Download run reads it too.</p>
}
else
{
    @foreach (var warning in summary.Warnings)
    {
        <p class="notice error snatch-warning" role="alert">
            @warning.Label: @warning.Count. See the <a href="@summary.MamProfileUrl" target="_blank" rel="noopener noreferrer">snatch lists on MAM</a>.
            @if (warning.Key == "ite")
            {
                <span class="tracker-error-note">MAM keeps counting a tracker error for 48 hours after it last occurred, so this stays after the cause is fixed.</span>
            }
        </p>
    }

    <h3>From MAM</h3>
    <p class="muted">As of <local-time value="summary.Snapshot!.FetchedAt" />.</p>
    <table id="account-numbers" class="key-values">
        <tbody>
            @if (account.Username is not null || account.ClassName is not null)
            {
                <tr><th>Account</th><td>@string.Join(", ", new[] { account.Username, account.ClassName }.Where(v => !string.IsNullOrEmpty(v)))</td></tr>
            }
            <tr><th>Ratio</th><td>@account.Ratio.ToString("0.##", CultureInfo.InvariantCulture)</td></tr>
            <tr><th>Uploaded / Downloaded</th><td>@Fetchshelf.Core.AutoDownloader.DownloadBudget.FormatBytes(account.UploadedBytes) / @Fetchshelf.Core.AutoDownloader.DownloadBudget.FormatBytes(account.DownloadedBytes)</td></tr>
            <tr><th>Unsatisfied snatches</th><td>@account.UnsatCount of @account.UnsatLimit</td></tr>
            <tr><th>Wedges</th><td>@account.Wedges.ToString("N0", CultureInfo.InvariantCulture)</td></tr>
            @if (account.BonusPoints is { } bonus)
            {
                <tr><th>Bonus points</th><td>@bonus.ToString("N0", CultureInfo.InvariantCulture)</td></tr>
            }
        </tbody>
    </table>

    @if (summary.Snatches.Count > 0)
    {
        <h3>Snatches</h3>
        <table id="snatches">
            <thead>
                <tr><th>Kind</th><th>Count</th><th>Size</th></tr>
            </thead>
            <tbody>
                @foreach (var snatch in summary.Snatches)
                {
                    <tr>
                        <td>@snatch.Label</td>
                        <td>@snatch.Count.ToString("N0", CultureInfo.InvariantCulture)</td>
                        <td class="nowrap">@snatch.Size</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Model.SeedingCounts is { } seedingCounts)
    {
        int Counted(string state) => seedingCounts.TryGetValue(state, out var count) ? count : 0;
        long MamCount(string key) => account.SnatchKinds.FirstOrDefault(k => k.Key == key)?.Count ?? 0;
        var seedingUnsat = Counted(nameof(Fetchshelf.Core.Organizer.SeedingState.SeedingUnsatisfied));
        var notSeedingUnsat = Counted(nameof(Fetchshelf.Core.Organizer.SeedingState.NotSeedingUnsatisfied));
        var past = Counted(nameof(Fetchshelf.Core.Organizer.SeedingState.PastThePeriod));
        <p id="seeding-estimate">
            Fetchshelf's estimate from qBittorrent's seeding time:
            <a asp-page="/Torrents/Index" asp-route-Seeding="@nameof(Fetchshelf.Core.Organizer.SeedingState.SeedingUnsatisfied)">@seedingUnsat seeding</a> and
            <a asp-page="/Torrents/Index" asp-route-Seeding="@nameof(Fetchshelf.Core.Organizer.SeedingState.NotSeedingUnsatisfied)">@notSeedingUnsat not seeding</a>
            of its torrents look unsatisfied@(past > 0 ? "," : ".")
            @if (past > 0)
            {
                <a asp-page="/Torrents/Index" asp-route-Seeding="@nameof(Fetchshelf.Core.Organizer.SeedingState.PastThePeriod)">@past past the period</a>@:.
            }
            @if (seedingUnsat != MamCount("seedUnsat") || notSeedingUnsat != MamCount("inactUnsat"))
            {
                <span class="muted">
                    MAM counts @MamCount("seedUnsat") and @MamCount("inactUnsat"). They can differ: snatches made outside Fetchshelf or
                    in another client, torrents Fetchshelf only has as metadata, and seeding time MAM counts differently. MAM's counts
                    are what matter.
                </span>
            }
        </p>
    }

    <h3>What Fetchshelf works out from it</h3>
    @if (summary.DerivedError is { } derivedError)
    {
        <p id="derived-error" class="notice error" role="alert">These numbers could not be worked out from the queue: @derivedError</p>
    }
    <table id="derived-numbers" class="key-values">
        <tbody>
            @if (summary.RatioBudget is { } ratioBudget)
            {
                <tr>
                    <th>Ratio budget</th>
                    <td>@ratioBudget.Value<br /><span class="muted">@ratioBudget.Formula</span></td>
                </tr>
            }
            @foreach (var slots in summary.SelectionSlots)
            {
                <tr>
                    <th>Selection slots<br /><span class="muted">@slots.Label</span></th>
                    <td>@slots.Value<br /><span class="muted">@slots.Formula</span></td>
                </tr>
            }
            @foreach (var wedges in summary.Wedges)
            {
                <tr>
                    <th>Wedges to spend<br /><span class="muted">@wedges.Label</span></th>
                    <td>@wedges.Value<br /><span class="muted">@wedges.Formula</span></td>
                </tr>
            }
            <tr>
                <th>Queue</th>
                <td id="queue-forecast">
                    @summary.Queued waiting on the <a asp-page="/Selected/Index">Selected</a> page; the numbers above would let the Download job start @summary.Startable of them.
                </td>
            </tr>
        </tbody>
    </table>
}

@* Shown even before the first read since startup: the history is in the database. *@
<h3>Over time</h3>
<div id="account-history">
    @if (Model.History.IsEmpty)
    {
        <p class="empty">Nothing recorded yet. A day is recorded once any job has read the account that day.</p>
    }
    else
    {
        <p class="muted">The last @Fetchshelf.Web.Pages.Account.AccountHistory.ChartDays days, one value a day: the account's last read that day. A day without any read is a gap.</p>
        <div class="history-charts">
            @foreach (var chart in Model.History.Charts)
            {
                <figure class="history-chart">
                    <figcaption><strong>@chart.Title</strong>@if (chart.From is not null)
                        {
                            <span class="muted"> @chart.From → @chart.To</span>
                        }</figcaption>
                    @Html.Raw(chart.Svg)
                </figure>
            }
        </div>
        <table id="account-months">
            <thead><tr><th>Month</th><th>Ratio</th><th>Uploaded</th><th>Downloaded</th><th>Bonus points</th><th>Wedges</th></tr></thead>
            <tbody>
                @foreach (var month in Model.History.Months)
                {
                    <tr>
                        <td class="nowrap">@month.Month</td>
                        <td>@month.Ratio.ToString("0.##", CultureInfo.InvariantCulture)</td>
                        <td class="nowrap">@DownloadBudget.FormatBytes(month.UploadedBytes)@if (month.UploadedChange is { } uploaded)
                            {
                                <br /><span class="muted">+@DownloadBudget.FormatBytes(uploaded)</span>
                            }</td>
                        <td class="nowrap">@DownloadBudget.FormatBytes(month.DownloadedBytes)@if (month.DownloadedChange is { } downloaded)
                            {
                                <br /><span class="muted">+@DownloadBudget.FormatBytes(downloaded)</span>
                            }</td>
                        <td class="nowrap">@(month.BonusPoints is { } points ? points.ToString("N0", CultureInfo.InvariantCulture) : "")@if (month.BonusPointsChange is { } pointsChange)
                            {
                                <br /><span class="muted">@(pointsChange >= 0 ? "+" : "−")@Math.Abs(pointsChange).ToString("N0", CultureInfo.InvariantCulture)</span>
                            }</td>
                        <td>@month.Wedges.ToString("N0", CultureInfo.InvariantCulture)</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="muted">Each month's last recorded day, and under it the change since the month before's. <a asp-page="/Account/Index" asp-page-handler="SnapshotsCsv">Download every day as CSV</a></p>
    }
</div>

@if (Model.Bonus is { } bonusView)
{
    <h3>Bonus points</h3>
    <div id="bonus">
        @if (bonusView.Settings is not { } bonusSettings)
        {
            <p class="muted">No <code>[bonus]</code> section: Fetchshelf spends no bonus points.@if (bonusView.UploadGbThePointsBuy is { } gb && gb > 0)
            {
                <text> The @BonusPlanner.Points(bonusView.Points!.Value) points would buy @gb.ToString("N0", CultureInfo.InvariantCulture) GB of upload credit.</text>
            }</p>
        }
        else
        {
            <table id="bonus-settings" class="key-values">
                <tbody>
                    <tr><th>Kept back</th><td>@BonusPlanner.Points(bonusSettings.KeepPoints) points, from upload credit and VIP</td></tr>
                    <tr><th>Upload credit</th><td>@(bonusSettings.UploadAmounts.Count == 0 ? "none" : string.Join(", ", bonusSettings.UploadAmounts.OrderDescending().Select(gb => $"{gb} GB")) + " at a time")</td></tr>
                    <tr>
                        <th>Wedges</th>
                        <td>
                            @if (bonusSettings.WedgeEvery == 0)
                            {
                                @:none
                            }
                            else
                            {
                                @:one every @bonusSettings.WedgeEvery hours@(bonusView.NextWedgeDue is null ? ", the next one due now" : "")
                                @if (bonusView.NextWedgeDue is { } due)
                                {
                                    <text>, the next one due <local-time value="due" /></text>
                                }
                            }
                        </td>
                    </tr>
                    <tr><th>VIP</th><td>@(bonusSettings.Vip ? "topped up every run" : "not bought")</td></tr>
                    @if (bonusSettings.DryRun)
                    {
                        <tr><th>Dry run</th><td>on: nothing is bought</td></tr>
                    }
                    @if (bonusView.NextRun is { } nextRun)
                    {
                        <tr>
                            <th>The next run</th>
                            <td id="bonus-next-run">
                                @(nextRun.Purchases.Count == 0 ? "buys nothing" : $"would buy {string.Join(", ", nextRun.Purchases.Select(p => p.Description))}"):
                                <span class="muted">@nextRun.StopReason</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (bonusView.Recent.Count > 0)
        {
            <table id="bonus-purchases">
                <thead><tr><th>Bought</th><th>What</th><th>Points</th></tr></thead>
                <tbody>
                    @foreach (var purchase in bonusView.Recent)
                    {
                        <tr>
                            <td><local-time value="purchase.OccurredAt" /></td>
                            <td>@Fetchshelf.Data.Notifications.EventNotifications.BonusPurchaseDescription(purchase.BonusSpend, purchase.BonusUploadGb)</td>
                            <td class="nowrap">@(purchase.PointsBefore is { } before ? BonusPlanner.Points(before) : "?") → @(purchase.PointsAfter is { } after ? BonusPlanner.Points(after) : "?")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

<h3>Connection to MAM</h3>
<ul id="mam-connection">
    <li>
        @if (summary.LastSuccessAt is { } lastSuccess)
        {
            <text>Last answered successfully <local-time value="lastSuccess" />.</text>
        }
        else
        {
            @:MAM hasn't answered successfully since Fetchshelf started.
        }
    </li>
    @if (account?.Connectable is { } connectable)
    {
        <li>Connectable: @connectable</li>
    }
    @if (summary.LastRefusal is { } refusal)
    {
        <li>Last refusal, <local-time value="refusal.At" />: @refusal.Message</li>
    }
</ul>
