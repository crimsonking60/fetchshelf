@model IReadOnlyList<Fetchshelf.Web.Pages.Jobs.JobStatusViewModel>

@if (Model.Count == 0)
{
    <p id="no-jobs-message" class="empty">No background jobs are registered yet.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Job</th>
                @if (Settings.JobExplanations)
                {
                    <th>Description</th>
                }
                <th>Last run</th>
                <th>Result</th>
                <th></th>
                <th>Next run in</th>
            </tr>
        </thead>
        <tbody>
            @{
                var now = DateTimeOffset.UtcNow;
            }
            @foreach (var job in Model)
            {
                <tr class="@(job.Failing is null ? null : "failing")">
                    <td><a asp-page="/Jobs/History" asp-route-job="@job.Name">@job.Name</a></td>
                    @if (Settings.JobExplanations)
                    {
                        <td>@job.Description</td>
                    }
                    <td>
                        @if (job.RunningText(now) is { } runningText)
                        {
                            @runningText
                        }
                        else if (job.LastStartedAt is { } lastStartedAt)
                        {
                            <local-time value="lastStartedAt" />
                            @if (job.LastDuration is { } duration)
                            {
                                <span class="muted nowrap">(took @Fetchshelf.Web.Pages.Jobs.JobRunLabels.Duration(duration))</span>
                            }
                        }
                        else
                        {
                            @:-
                        }
                    </td>
                    <td>
                        <span title="@job.CountsText">@job.LastResultText</span>
                        @if (job.Failing is { } failing)
                        {
                            <div class="failing-since">failing since <local-time value="failing.Since" /> @Fetchshelf.Web.Pages.Errors.FailingJobText.Runs(failing.FailedRuns)</div>
                        }
                    </td>
                    <td>
                        @* Cancelling loses nothing the next run doesn't redo, so it asks for no confirmation. *@
                        @{
                            var handler = job.IsRunning ? "Cancel" : "Trigger";
                        }
                        <form method="post" action="?handler=@handler" hx-post="?handler=@handler" hx-target="#job-list" hx-swap="innerHTML">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="jobName" value="@job.Name" />
                            @if (job.IsRunning)
                            {
                                <input type="hidden" name="runNumber" value="@job.RunNumber" />
                            }
                            <button type="submit">@(job.IsRunning ? "Cancel" : "Run now")</button>
                        </form>
                    </td>
                    <td class="next-run">@job.NextRunText(now)</td>
                </tr>
            }
        </tbody>
    </table>
}
