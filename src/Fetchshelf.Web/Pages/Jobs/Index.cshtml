@page
@model IndexModel
@using Fetchshelf.Web.Jobs
@{
    ViewData["Title"] = "Jobs";

    // Live job-list refresh. Set to false while testing/debugging if the 2s polling floods the
    // logs or interferes with breakpoints. The poll sends the version of the list it shows (jobs.js) and gets an empty
    // answer, which leaves the list alone, until a job starts, ends or moves; it waits while the tab is hidden.
    const bool pollJobs = true;
}

<h2>Jobs</h2>
@await Html.PartialAsync("_PageExplanation", "This page shows the status of Fetchshelf's background jobs, such as searching, linking, and importing. Use the \"Run now\" button next to a job to trigger it right away instead of waiting for its schedule, or \"Cancel\" to stop a running one. Select a job's name to see its earlier runs.")

@if (Model.Account is { } account)
{
    @await Html.PartialAsync("/Pages/Account/_AccountStripPartial.cshtml", account)
}

<div id="job-list" hx-get="@(pollJobs ? "?handler=JobsPartial" : null)" hx-trigger="@(pollJobs ? "every 2s [!document.hidden], visibilitychange from:document [!document.hidden]" : null)" hx-swap="innerHTML">
    @await Html.PartialAsync("_JobListPartial", Model.JobList)
</div>

@if (Model.BulkOperations.Count > 0)
{
    <div id="bulk-operations-running">
        <h3>Bulk actions from the Torrents, Library check and torrent pages</h3>
        @foreach (var operation in Model.BulkOperations)
        {
            var (bulkPage, pageName) = operation.Page switch
            {
                BulkOperationPage.LibraryCheck => ("/LibraryCheck/Index", "Library check page"),
                BulkOperationPage.Torrent => ("/Torrents/Detail", "Torrent page"),
                _ => ("/Torrents/Index", "Torrents page"),
            };
            var torrentId = operation.Page == BulkOperationPage.Torrent ? operation.ItemIds[0] : null;
            <div class="notice bulk-operation" role="status">
                <span>@operation.Status() <a asp-page="@bulkPage" asp-route-id="@torrentId">@pageName</a></span>
                @if (operation.CanCancel)
                {
                    <form method="post" asp-page="@bulkPage" asp-page-handler="CancelBulk" asp-route-id="@torrentId">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="operationId" value="@operation.Id" />
                        <button type="submit">Cancel</button>
                    </form>
                }
            </div>
        }
    </div>
}

@section Scripts {
    <script src="~/js/jobs.js" defer></script>
}
