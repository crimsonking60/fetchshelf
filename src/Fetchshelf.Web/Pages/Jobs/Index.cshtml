@page
@model IndexModel
@{
    ViewData["Title"] = "Jobs";

    // Live job-list refresh. Set to false while testing/debugging if the 2s polling floods the
    // logs or interferes with breakpoints.
    const bool pollJobs = true;
}

<h2>Jobs</h2>
@await Html.PartialAsync("_PageExplanation", "This page shows the status of Fetchshelf's background jobs, such as searching, linking, and importing. Use the \"Run now\" button next to a job to trigger it right away instead of waiting for its schedule.")

<div id="job-list" hx-get="@(pollJobs ? "?handler=JobsPartial" : null)" hx-trigger="@(pollJobs ? "every 2s" : null)" hx-swap="innerHTML">
    @await Html.PartialAsync("_JobListPartial", Model.Jobs)
</div>

@* Outside the polled list: what is configured only changes with a restart. *@
@if (Model.Unconfigured.Count > 0)
{
    <div id="unconfigured-jobs" class="unconfigured-jobs muted">
        @foreach (var name in Model.Unconfigured)
        {
            <p>@name is not configured</p>
        }
    </div>
}
