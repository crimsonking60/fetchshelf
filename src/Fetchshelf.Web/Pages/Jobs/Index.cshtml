@page
@model IndexModel
@{
    ViewData["Title"] = "Jobs";

    // Live job-list refresh. Set to false while testing/debugging if the 2s polling floods the
    // logs or interferes with breakpoints.
    const bool pollJobs = true;
}

<h2>Jobs</h2>
@await Html.PartialAsync("_PageExplanation", "This page shows the status of Fetchshelf's background jobs, such as searching, linking, and importing. Use the \"Run now\" button next to a job to trigger it right away instead of waiting for its schedule, or \"Cancel\" to stop a running one. Select a job's name to see its earlier runs.")

@if (Model.Account is { } account)
{
    @await Html.PartialAsync("/Pages/Account/_AccountStripPartial.cshtml", account)
}

<div id="job-list" hx-get="@(pollJobs ? "?handler=JobsPartial" : null)" hx-trigger="@(pollJobs ? "every 2s" : null)" hx-swap="innerHTML">
    @await Html.PartialAsync("_JobListPartial", Model.JobList)
</div>

@if (Model.BulkOperations.Count > 0)
{
    <div id="bulk-operations-running">
        <h3>Bulk actions from the Torrents page</h3>
        @foreach (var operation in Model.BulkOperations)
        {
            <div class="notice bulk-operation" role="status">
                <span>@operation.Status() <a asp-page="/Torrents/Index">Torrents page</a></span>
                <form method="post" asp-page="/Torrents/Index" asp-page-handler="CancelBulk">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="operationId" value="@operation.Id" />
                    <button type="submit">Cancel</button>
                </form>
            </div>
        }
    </div>
}
