@page
@model Fetchshelf.Web.Pages.Config.IndexModel
@using Fetchshelf.Data.Configuration
@{
    ViewData["Title"] = "Config";
    var settings = Model.Settings;

    string MetadataFiles(Library library) =>
        string.Join(", ", new[] { library.MetadataJson ? "metadata.json" : null, library.MetadataOpf ? "metadata.opf" : null }.OfType<string>()) is { Length: > 0 } files
            ? files
            : "none";
}

<h2>Config</h2>
@await Html.PartialAsync("_PageExplanation", "This page is a read-only view of Fetchshelf's active configuration, loaded from config.toml. Secrets like mam_id and passwords are hidden, but you can trigger an autograbber, or preview a tag rule and apply it, directly from here.")

@if (Model.ActionMessage is { } actionMessage)
{
    <p id="action-message" class="notice@(Model.ActionFailed ? " error" : "")" role="@(Model.ActionFailed ? "alert" : "status")">@actionMessage</p>
}

<p id="app-version">Fetchshelf version <strong>@Fetchshelf.Web.AppVersion.Current</strong></p>

<section>
    <h3>Settings</h3>
    <table>
        <tbody>
            <tr><th>mam_id</th><td>@IndexModel.HiddenPlaceholder</td></tr>
            <tr><th>mam_id_file</th><td>@settings.MamIdFile</td></tr>
            <tr><th>web_host</th><td>@settings.WebHost</td></tr>
            <tr><th>web_url</th><td>@settings.WebUrl</td></tr>
            <tr><th>web_port</th><td>@settings.WebPort</td></tr>
            <tr><th>min_ratio</th><td>@settings.MinRatio</td></tr>
            <tr><th>unsat_buffer</th><td>@settings.UnsatBuffer</td></tr>
            <tr><th>wedge_buffer</th><td>@settings.WedgeBuffer</td></tr>
            <tr><th>add_torrents_stopped</th><td>@settings.AddTorrentsStopped</td></tr>
            <tr><th>page_explanations</th><td>@settings.PageExplanations</td></tr>
            <tr><th>job_explanations</th><td>@settings.JobExplanations</td></tr>
            <tr><th>exclude_narrator_in_library_dir</th><td>@settings.ExcludeNarratorInLibraryDir</td></tr>
            <tr><th>link_method</th><td>@settings.LinkMethod</td></tr>
            <tr><th>metadata_json</th><td>@settings.MetadataJson</td></tr>
            <tr><th>metadata_opf</th><td>@settings.MetadataOpf</td></tr>
            <tr><th>database_wal</th><td>@settings.DatabaseWal</td></tr>
            <tr><th>search_interval</th><td>@settings.SearchInterval</td></tr>
            <tr><th>link_interval</th><td>@settings.LinkInterval</td></tr>
            <tr><th>ignore_torrents</th><td>@string.Join(", ", settings.IgnoreTorrents)</td></tr>
            <tr><th>extra_categories</th><td>@string.Join(", ", settings.ExtraCategories)</td></tr>
            <tr><th>languages</th><td>@(settings.Languages.Count == 0 ? "any" : string.Join(", ", settings.Languages))</td></tr>
            <tr><th>audio_types</th><td>@string.Join(", ", settings.AudioTypes)</td></tr>
            <tr><th>ebook_types</th><td>@string.Join(", ", settings.EbookTypes)</td></tr>
            <tr><th>music_types</th><td>@string.Join(", ", settings.MusicTypes)</td></tr>
            <tr><th>radio_types</th><td>@string.Join(", ", settings.RadioTypes)</td></tr>
            <tr><th>search.wedge_over</th><td>@settings.Search.WedgeOver</td></tr>
        </tbody>
    </table>
</section>

<section>
    <h3>qBittorrent connections</h3>
    @if (settings.QBittorrent.Count == 0)
    {
        <p class="empty">No [[qbittorrent]] connections configured.</p>
    }
    else
    {
        <table>
            <thead><tr><th>Url</th><th>Username</th><th>Password</th><th>Path mapping</th></tr></thead>
            <tbody>
                @foreach (var connection in settings.QBittorrent)
                {
                    <tr>
                        <td>@connection.Url</td>
                        <td>@connection.Username</td>
                        <td>@IndexModel.HiddenPlaceholder</td>
                        <td>@string.Join(", ", connection.PathMapping.Select(p => $"{p.Key} -> {p.Value}"))</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section>
    <h3>Libraries</h3>
    @if (settings.Library.Count == 0)
    {
        <p class="empty">No [[library]] entries configured.</p>
    }
    else
    {
        <table>
            <thead><tr><th>Name</th><th>Library dir</th><th>Category</th><th>Download dir</th><th>Method</th><th>Metadata files</th></tr></thead>
            <tbody>
                @foreach (var library in settings.Library)
                {
                    <tr>
                        <td>@library.Name</td>
                        <td>@library.LibraryDir</td>
                        <td>@library.Category</td>
                        <td>@library.DownloadDir</td>
                        <td>@library.Method</td>
                        <td>@MetadataFiles(library)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section>
    <h3>OPDS catalog</h3>
    @if (settings.Opds is not { } opds)
    {
        <p class="empty">No [opds] section configured, so no OPDS catalog is served.</p>
    }
    else
    {
        <table>
            <tbody>
                <tr><th>Catalog address</th><td><code id="opds-url">@($"{ViewContext.HttpContext.Request.Scheme}://{ViewContext.HttpContext.Request.Host}/opds")</code></td></tr>
                <tr><th>libraries</th><td>@(opds.Libraries.Count == 0 ? "all" : string.Join(", ", opds.Libraries))</td></tr>
            </tbody>
        </table>
    }
</section>

<section>
    <h3>Autograbbers</h3>
    @if (settings.Autograb.Count == 0)
    {
        <p class="empty">No [[autograb]] entries configured.</p>
    }
    else
    {
        <table>
            <thead><tr><th>Name</th><th>Type</th><th>Cost</th><th>Category</th><th></th></tr></thead>
            <tbody>
                @for (var i = 0; i < settings.Autograb.Count; i++)
                {
                    var entry = settings.Autograb[i];
                    <tr>
                        <td>@entry.Name</td>
                        <td>@entry.Type</td>
                        <td>@entry.Cost</td>
                        <td>@entry.Category</td>
                        <td>
                            <form method="post" action="/Jobs?handler=Trigger">
                                <input type="hidden" name="jobName" value="@AutoDownloaderJobNames.Autograb(entry, i)" />
                                @Html.AntiForgeryToken()
                                <button type="submit">Run now</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section>
    <h3>Snatchlists</h3>
    @if (settings.Snatchlist.Count == 0)
    {
        <p class="empty">No [[snatchlist]] entries configured.</p>
    }
    else
    {
        <table>
            <thead><tr><th>Name</th><th>Type</th><th>Cost</th></tr></thead>
            <tbody>
                @foreach (var entry in settings.Snatchlist)
                {
                    <tr>
                        <td>@entry.Name</td>
                        <td>@entry.Type</td>
                        <td>@entry.Cost</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section>
    <h3>Hardcover lists</h3>
    @if (settings.HardcoverList.Count == 0)
    {
        <p class="empty">No [[hardcover_list]] entries configured.</p>
    }
    else
    {
        <table>
            <thead><tr><th>Name</th><th>Books</th><th>Preferred format</th><th>Grab costs</th><th>Category</th><th>Dry run</th></tr></thead>
            <tbody>
                @foreach (var entry in settings.HardcoverList)
                {
                    <tr>
                        <td>@entry.Name</td>
                        <td>@(entry.List is { } slug ? $"list {slug}" : $"status {entry.Status}")</td>
                        <td>@(entry.PreferFormat?.ToString() ?? "-")</td>
                        <td>@string.Join(", ", entry.Grab.Select(g => g.Cost))</td>
                        <td>@entry.Category</td>
                        <td>@(entry.DryRun ? "yes" : "no")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section>
    <h3>Following</h3>
    @if (settings.Follow is not { } follow)
    {
        <p class="empty">No [follow] section configured.</p>
    }
    else
    {
        <table id="follow-settings">
            <thead><tr><th>Searches per run</th><th>Search again after</th><th>Interval</th><th>Preferred format</th><th>Grab costs</th><th>Category</th><th>Dry run</th></tr></thead>
            <tbody>
                <tr>
                    <td>@follow.SearchesPerRun</td>
                    <td>@follow.SearchAgainAfter hours</td>
                    <td>@(follow.SearchInterval is { } interval ? $"{interval} minutes" : "global")</td>
                    <td>@(follow.PreferFormat?.ToString() ?? "-")</td>
                    <td>@string.Join(", ", follow.Grab.Select(g => g.Cost))</td>
                    <td>@follow.Category</td>
                    <td>@(follow.DryRun ? "yes" : "no")</td>
                </tr>
            </tbody>
        </table>
    }
</section>

<section>
    <h3>Upgrades</h3>
    @if (settings.Upgrade is not { } upgrade)
    {
        <p class="empty">No [upgrade] section configured.</p>
    }
    else
    {
        <table id="upgrade-settings">
            <thead><tr><th>Searches per run</th><th>Search again after</th><th>Interval</th><th>Libraries</th><th>Grab costs</th><th>Dry run</th></tr></thead>
            <tbody>
                <tr>
                    <td>@upgrade.SearchesPerRun</td>
                    <td>@upgrade.SearchAgainAfter days</td>
                    <td>@(upgrade.SearchInterval is { } interval ? $"{interval} minutes" : "global")</td>
                    <td>@(upgrade.Libraries.Count == 0 ? "all" : string.Join(", ", upgrade.Libraries))</td>
                    <td>@string.Join(", ", upgrade.Grab.Select(g => g.Cost))</td>
                    <td>@(upgrade.DryRun ? "yes" : "no")</td>
                </tr>
            </tbody>
        </table>
    }
</section>

<section>
    <h3>Bonus points</h3>
    @if (settings.Bonus is not { } bonus)
    {
        <p class="empty">No [bonus] section configured: no bonus points are spent.</p>
    }
    else
    {
        <table id="bonus-settings">
            <thead><tr><th>Keep points</th><th>Upload amounts</th><th>Wedge every</th><th>VIP</th><th>Max purchases per run</th><th>Interval</th><th>Dry run</th></tr></thead>
            <tbody>
                <tr>
                    <td>@bonus.KeepPoints</td>
                    <td>@(bonus.UploadAmounts.Count == 0 ? "none" : string.Join(", ", bonus.UploadAmounts.Select(gb => $"{gb} GB")))</td>
                    <td>@(bonus.WedgeEvery == 0 ? "never" : $"{bonus.WedgeEvery} hours")</td>
                    <td>@(bonus.Vip ? "yes" : "no")</td>
                    <td>@bonus.MaxPurchasesPerRun</td>
                    <td>@(bonus.BonusInterval == 0 ? "Jobs page only" : $"{bonus.BonusInterval} minutes")</td>
                    <td>@(bonus.DryRun ? "yes" : "no")</td>
                </tr>
            </tbody>
        </table>
    }
</section>

<section>
    <h3>Backups</h3>
    @if (settings.Backup is not { } backup)
    {
        <p class="empty">No [backup] section configured: Fetchshelf takes no backups of its database.</p>
    }
    else
    {
        <table id="backup-settings">
            <thead><tr><th>Folder</th><th>Interval</th><th>Keep</th><th>Before upgrades</th></tr></thead>
            <tbody>
                <tr>
                    <td>@backup.Folder</td>
                    <td>@(backup.Interval == 0 ? "Jobs page only" : $"{backup.Interval} minutes")</td>
                    <td>@backup.Keep</td>
                    <td>@(backup.BeforeUpgrade ? $"yes, the last {Fetchshelf.Data.Configuration.BackupSettings.KeepBeforeUpgrade} kept" : "no")</td>
                </tr>
            </tbody>
        </table>
    }
</section>

<section>
    <h3>Notifications</h3>
    @if (Model.NotifyTargets.Count == 0)
    {
        <p class="empty">No [[notify]] entries configured.</p>
    }
    else
    {
        <table id="notify-blocks">
            <thead><tr><th>Name</th><th>Format</th><th>Events</th><th>URL</th><th></th></tr></thead>
            <tbody>
                @for (var i = 0; i < Model.NotifyTargets.Count; i++)
                {
                    var target = Model.NotifyTargets[i];
                    <tr>
                        <td>@target.Name</td>
                        <td>@Fetchshelf.Core.Notifications.NotificationFormatNames.Name(target.Format)</td>
                        <td>@IndexModel.DescribeEvents(target)</td>
                        @* The address is a secret: topics and webhook URLs often are one. *@
                        <td>@(IndexModel.HiddenPlaceholder)</td>
                        <td>
                            <form method="post" asp-page-handler="TestNotify" asp-route-index="@i">
                                @Html.AntiForgeryToken()
                                <button type="submit">Send a test message</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section>
    <h3>Tag rules</h3>
    @if (settings.Tag.Count == 0)
    {
        <p class="empty">No [[tag]] entries configured.</p>
    }
    else
    {
        <table>
            <thead><tr><th>Name</th><th>Matches</th><th>Category applied</th><th>Tags applied</th><th></th></tr></thead>
            <tbody>
                @for (var i = 0; i < settings.Tag.Count; i++)
                {
                    var entry = settings.Tag[i];
                    <tr>
                        <td>@entry.Name</td>
                        <td class="tag-rule-filter">
                            @* Every condition of the rule's filter, so it is clear which torrents get the category and tags. *@
                            @foreach (var line in Fetchshelf.Web.Pages.Config.FilterDescription.Describe(entry))
                            {
                                @line<br />
                            }
                        </td>
                        <td>@entry.Category</td>
                        <td>@string.Join(", ", entry.Tags)</td>
                        <td>
                            @* Shows what it would change first; applying is a second step, under the preview. *@
                            <form method="post" asp-page-handler="PreviewTagRule" asp-route-ruleIndex="@i"
                                  hx-post="@Url.Page("/Config/Index", "PreviewTagRule", new { ruleIndex = i })"
                                  hx-target="#tag-rule-dialog-body" hx-swap="innerHTML">
                                @Html.AntiForgeryToken()
                                <button type="submit">Preview applying to existing torrents</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Model.PreviewViewModel is { } previewModel)
    {
        @* Asked for without htmx: shown on the page instead of in the dialog. *@
        <partial name="_TagRulePreviewPartial" model="previewModel" />
    }

    @* The preview of a rule opens here, over the page, so the page keeps its place. *@
    <dialog id="tag-rule-dialog" class="hit-dialog" aria-label="What applying the tag rule would change">
        <div class="hit-dialog-bar">
            <button type="button" id="tag-rule-dialog-close">Close</button>
        </div>
        <div id="tag-rule-dialog-body"></div>
    </dialog>
    <script>
        (function () {
            const dialog = document.getElementById('tag-rule-dialog');
            const body = document.getElementById('tag-rule-dialog-body');
            document.body.addEventListener('htmx:beforeRequest', function (event) {
                if (event.detail.target === body) {
                    body.innerHTML = '<p class="muted">Working out what it would change…</p>';
                    if (!dialog.open) {
                        dialog.showModal();
                    }
                }
            });
            document.getElementById('tag-rule-dialog-close').addEventListener('click', function () {
                dialog.close();
            });
            dialog.addEventListener('click', function (event) {
                if (event.target === dialog) {
                    dialog.close();
                }
            });
        })();
    </script>
</section>
