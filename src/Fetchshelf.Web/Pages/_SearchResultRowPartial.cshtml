@model (Fetchshelf.Web.Pages.SearchResultViewModel Result, bool SwapOob)
@{
    var result = Model.Result;
}
@* SwapOob is set when htmx returns this row after a download, to replace the row already on the page (see _DownloadFeedbackPartial). *@
<tr id="result-@result.MamId" hx-swap-oob="@(Model.SwapOob ? "true" : null)" data-media-type="@result.MediaTypeSlug" data-status="@result.Status.ToString().ToLowerInvariant()" data-in-qbittorrent="@(result.InQBittorrent == true ? "true" : null)">
    @* A click opens the details in a dialog over the results, which stay as they are; the link itself is the full page, for a new tab. *@
    <td><a asp-page="/Search/Detail" asp-route-mamId="@result.MamId" asp-route-Q="@Context.Request.Query["Q"]"
           hx-get="@Url.Page("/Search/Detail", "Partial", new { mamId = result.MamId })" hx-target="#hit-dialog-body" hx-swap="innerHTML">@result.Title</a></td>
    <td>
        @if (result.AuthorsShortened)
        {
            @* Focusable so the full list is also reachable by keyboard and touch (:focus-within shows the balloon). *@
            <span class="has-tip" tabindex="0">@result.AuthorsShortDisplay<span class="tip" role="tooltip">@result.AuthorsDisplay</span></span>
        }
        else
        {
            @result.AuthorsDisplay
        }
    </td>
    <td>@result.MediaTypeLabel</td>
    <td class="nowrap">
        @if (result.MetadataQuality is { } quality)
        {
            @* Focusable so what is missing is also reachable by keyboard and touch, like the authors' balloon. *@
            <span class="has-tip" tabindex="0"><span class="quality-pill quality-@quality.Grade.ToString().ToLowerInvariant()">@result.MetadataQualityLabel</span><span class="tip" role="tooltip">@result.MetadataQualityDetail</span></span>
        }
    </td>
    <td>
        @await Html.PartialAsync("_SearchResultStatusPartial", new SearchResultStatusViewModel(result.MamId, result.Status))
        @if (result.InQBittorrent == true)
        {
            var category = string.IsNullOrEmpty(result.QBittorrentCategory) ? "no category" : result.QBittorrentCategory;
            <span class="status-badge status-qbittorrent" title="In qBittorrent, category: @category">qBittorrent: @category</span>
        }
        else if (result.InQBittorrent == false && result.Status is MamResultStatus.Downloading or MamResultStatus.Downloaded or MamResultStatus.Linked)
        {
            <span class="status-badge status-not-in-qbittorrent" title="Fetchshelf has this torrent, but qBittorrent no longer does">Not in qBittorrent</span>
        }
    </td>
    <td class="nowrap">@result.SizeDisplay</td>
    <td class="nowrap">
        @if (result.IsVip) { <span class="badge-vip">VIP</span> }
        @if (result.IsPersonalFreeleech) { <span class="badge-personal-freeleech">Personal FL</span> }
        @if (result.IsFree) { <span class="badge-freeleech">FL</span> }
    </td>
    <td>
        @if (result.InQBittorrent == true && result.Status is MamResultStatus.None or MamResultStatus.Selected)
        {
            @* qBittorrent has it already: downloading again makes no sense, recording it does. *@
            <form method="post" asp-page="/Index" asp-page-handler="Import" class="inline"
                  hx-post="@Url.Page("/Index", "Import")" hx-target="#download-message-area" hx-swap="innerHTML" hx-disabled-elt="find button">
                @Html.AntiForgeryToken()
                <input type="hidden" name="mamId" value="@result.MamId" />
                <button type="submit" title="Record this torrent in Fetchshelf without downloading it again">Import</button>
            </form>
        }
        else if (result.InQBittorrent != true && result.CannotDownloadReason is { } reason)
        {
            @* Selecting it would fail on its formats, so there is nothing to click: say why instead. *@
            <span class="has-tip muted" tabindex="0">Can't download<span class="tip" role="tooltip">@reason</span></span>
        }
        else if (result.InQBittorrent != true)
        {
            <form method="post" asp-page="/Index" asp-page-handler="Download" class="inline"
                  hx-post="@Url.Page("/Index", "Download")" hx-target="#download-message-area" hx-swap="innerHTML" hx-disabled-elt="find button">
                @Html.AntiForgeryToken()
                <input type="hidden" name="mamId" value="@result.MamId" />
                <button type="submit">@(Settings.DownloadAfterSelection ? "Download" : "Select")</button>
            </form>
            <form method="post" asp-page="/Index" asp-page-handler="Download" class="inline"
                  hx-post="@Url.Page("/Index", "Download")" hx-target="#download-message-area" hx-swap="innerHTML" hx-disabled-elt="find button">
                @Html.AntiForgeryToken()
                <input type="hidden" name="mamId" value="@result.MamId" />
                <input type="hidden" name="wedge" value="true" />
                <button type="submit" class="@(result.WedgePreHighlighted ? "wedge-highlighted" : "")">@(Settings.DownloadAfterSelection ? "Wedge\u00a0download" : "Wedge\u00a0select")</button>
            </form>
        }
    </td>
</tr>
