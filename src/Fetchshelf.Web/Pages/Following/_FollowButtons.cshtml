@model Fetchshelf.Web.Pages.Following.FollowButtonsViewModel
@using Fetchshelf.Data.Entities
@foreach (var (name, state) in Model.Buttons)
{
    if (state is { Mode: FollowMode.Ignore })
    {
        @* An ignored series has no page of its own; the Series page is where it is ignored, and followed again. *@
        <a class="follow-state" asp-page="/Series/Index">Ignored @name.Name</a>
    }
    else if (state is not null)
    {
        <a class="follow-state" asp-page="/Following/Detail" asp-route-id="@state.Id">Following @name.Name</a>
    }
    else
    {
        <form method="post" asp-page="/Following/Index" asp-page-handler="Follow" class="inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="kind" value="@Model.Kind" />
            <input type="hidden" name="key" value="@name.Key" />
            <input type="hidden" name="name" value="@name.Name" />
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <button type="submit" title="@(Model.Kind == FollowKind.Series ? "List this series' missing and future books on the Following page" : "List this author's new books on the Following page")">Follow @name.Name</button>
        </form>
    }
}
