@page
@model Fetchshelf.Web.Pages.Following.IndexModel
@using Fetchshelf.Data.Entities
@{
    ViewData["Title"] = "Following";
}

<h2>Following</h2>
@await Html.PartialAsync("_PageExplanation", "This page lists the followed series and authors, with how many books the Follow job found for each: books the library is missing. A series or author on Auto has what is found downloaded automatically; a followed one has it listed, to download or dismiss, on its own page and on the To look at page."
    + (Model.ShowsNotFree ? " A find marked not free matched, but no grab block in the [follow] section pays for it; it can still be downloaded." : "")
    + " Series are followed on the Series page, authors and series from a torrent's page or the Torrents page.")

@if (Model.CanFollow)
{
    @* Why a book on Auto isn't downloaded is usually its cost: the grab blocks say what is taken by itself. *@
    <section id="follow-rules" class="notice">
        <strong>What is downloaded automatically.</strong>
        @if (Model.DryRun)
        {
            <p>Nothing for now: <code>dry_run</code> is on in <code>[follow]</code>, so the Follow job only logs what it would download.</p>
        }
        @* One rule or several, each on its own line, so a rule's own colon never follows the intro's. *@
        @if (Model.GrabRules.Count == 1)
        {
            <p>For a series or author on Auto, this decides what is downloaded:</p>
            <ul>
                <li>@Model.GrabRules[0]</li>
            </ul>
        }
        else
        {
            <p>For a series or author on Auto, the first of these that allows a book decides how it is downloaded:</p>
            <ol>
                @foreach (var rule in Model.GrabRules)
                {
                    <li>@rule</li>
                }
            </ol>
        }
        <p>
            @if (Model.ShowsNotFree)
            {
                <text>A book found that costs more is listed as <em>Not free</em>; <strong>Download</strong> or <strong>Wedge download</strong> takes it anyway.</text>
            }
            A followed series or author only has what is found listed.
        </p>
        <p>These rules are configured with <code>[[follow.grab]]</code> blocks in the configuration.</p>
    </section>
}

@if (Model.Message is { } message)
{
    <p id="follow-message" class="notice@(Model.MessageIsError ? " error" : "")" role="@(Model.MessageIsError ? "alert" : "status")">@message</p>
}

@if (!Model.CanFollow)
{
    <p id="follow-not-configured" class="empty">Following needs a [follow] section in the configuration; see the user guide.</p>
}
else if (!Model.AnyFollows)
{
    <p id="no-follows-message" class="empty">Nothing is followed yet. Follow a series on the <a asp-page="/Series/Index">Series</a> page, or an author or series from a torrent's page.</p>
}
else
{
    var query = Model.Query;
    <p id="to-look-at-link"><a asp-page="/Following/ToLookAt">To look at (@Model.ToLookAt)</a>: what waits to be downloaded or dismissed, of every series and author.</p>

    @* A changed dropdown applies straight away, as on the Torrents page; the button is for the search text. *@
    <form method="get" class="toolbar" id="follow-filters">
        <input type="text" name="Q" value="@Model.Q" placeholder="Search names" aria-label="Search" />
        <button type="submit">Search</button>
        <select name="Kind" aria-label="Kind" onchange="this.form.requestSubmit()">
            <option value="">Series and authors</option>
            <option value="@FollowKind.Series" selected="@(Model.Kind == FollowKind.Series)">Series</option>
            <option value="@FollowKind.Author" selected="@(Model.Kind == FollowKind.Author)">Authors</option>
        </select>
        <select name="Mode" aria-label="Mode" onchange="this.form.requestSubmit()">
            <option value="">Auto and followed</option>
            <option value="@FollowMode.Download" selected="@(Model.Mode == FollowMode.Download)">Auto</option>
            <option value="@FollowMode.Watch" selected="@(Model.Mode == FollowMode.Watch)">Followed</option>
        </select>
        <label><input type="checkbox" name="Waiting" value="true" checked="@Model.Waiting" onchange="this.form.requestSubmit()" /> With books to look at</label>
        <input type="hidden" name="Sort" value="@Model.Sort" />
        <input type="hidden" name="Dir" value="@Model.Dir" />
        <input type="hidden" name="PageSize" value="@Model.PageSize" />
        @if (query.HasFilters)
        {
            <a id="clear-filters" asp-page="/Following/Index" asp-all-route-data="query.WithoutFilters().ToRouteValues()">Clear filters</a>
        }
    </form>

    @if (Model.Follows.Count == 0)
    {
        <p id="no-matches-message" class="empty">No series or author matches.</p>
    }
    else
    {
        <table class="follows">
            <thead>
                <tr>
                    <th><a asp-page="/Following/Index" asp-all-route-data='query.SortedBy("Name").ToRouteValues()'>Name</a></th>
                    <th>Kind</th>
                    <th>Mode</th>
                    <th><a asp-page="/Following/Index" asp-all-route-data='query.SortedBy("ToLookAt").ToRouteValues()'>To look at</a></th>
                    @if (Model.ShowsNotFree)
                    {
                        <th>Not free</th>
                    }
                    <th>Selected</th>
                    <th>In the library</th>
                    <th><a asp-page="/Following/Index" asp-all-route-data='query.SortedBy("Searched").ToRouteValues()'>Last searched</a></th>
                    <th>Searched again after</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var summary in Model.Follows)
                {
                    var follow = summary.Follow;
                    <tr id="follow-@follow.Id">
                        <td><a asp-page="/Following/Detail" asp-route-id="@follow.Id">@follow.DisplayName</a></td>
                        <td>@(follow.Kind == FollowKind.Series ? "Series" : "Author")</td>
                        <td class="nowrap">
                            @if (follow.Mode == FollowMode.Download)
                            {
                                <span class="status-badge status-linked" title="Downloaded automatically">Auto</span>
                            }
                            else
                            {
                                <span class="status-badge status-selected" title="Download yourself">Followed</span>
                            }
                        </td>
                        <td>@(summary.ToLookAt > 0 ? summary.ToLookAt : "")</td>
                        @if (Model.ShowsNotFree)
                        {
                            <td>@(summary.NotFree > 0 ? summary.NotFree : "")</td>
                        }
                        <td>@(summary.Selected > 0 ? summary.Selected : "")</td>
                        <td>@(summary.InLibrary > 0 ? summary.InLibrary : "")</td>
                        @if (follow.LastSearchedAt is { } searched)
                        {
                            <td><local-time value="searched" /></td>
                            <td><local-time value="Model.SearchAgainAfter(searched)" /></td>
                        }
                        else
                        {
                            <td class="muted">Not yet</td>
                            <td></td>
                        }
                        <td class="nowrap">
                            <partial name="_FollowActions" model="new Fetchshelf.Web.Pages.Following.FollowActionsViewModel(follow, Model.ReturnUrl, Model.ReturnUrl)" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @await Html.PartialAsync("_Pager", Model.Pager)
    }
}
