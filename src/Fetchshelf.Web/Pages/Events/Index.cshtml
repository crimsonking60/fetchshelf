@page
@model Fetchshelf.Web.Pages.Events.IndexModel
@{
    ViewData["Title"] = "Events";
}

<h2>Events</h2>
@await Html.PartialAsync("_PageExplanation", "This page is a log of everything Fetchshelf has done, such as grabbing, linking, and cleaning up torrents. Filter by type, by the job that grabbed a torrent, or by the library that linked it; updates can also be filtered by the field they changed.")

@* A changed dropdown applies straight away, as on the Torrents page. *@
<form method="get" class="toolbar">
    <select name="Type" aria-label="Type" onchange="this.form.requestSubmit()">
        <option value="">All types</option>
        @foreach (var kind in Enum.GetValues<Fetchshelf.Data.Entities.EventKind>())
        {
            <option value="@kind" selected="@(Model.Type == kind)">@EventLabels.For(kind)</option>
        }
    </select>
    <select name="Grabber" aria-label="Grabbed by" onchange="this.form.requestSubmit()">
        <option value="">Grabbed by any job</option>
        @foreach (var grabber in Model.GrabberOptions)
        {
            <option value="@grabber" selected="@(Model.Grabber == grabber)">@grabber</option>
        }
    </select>
    <select name="Linker" aria-label="Library" onchange="this.form.requestSubmit()">
        <option value="">Any library</option>
        @foreach (var linker in Model.LinkerOptions)
        {
            <option value="@linker" selected="@(Model.Linker == linker)">@linker</option>
        }
    </select>
    @if (Model.FiltersByField)
    {
        <select name="Field" aria-label="Changed field" onchange="this.form.requestSubmit()">
            <option value="">Any changed field</option>
            @foreach (var field in IndexModel.FieldOptions)
            {
                <option value="@field" selected="@(Model.Field == field)">@EventLabels.FieldName(field)</option>
            }
        </select>
    }
    <input type="hidden" name="PageSize" value="@Model.PageSize" />
    <input type="hidden" name="Sort" value="@Model.Sort" />
    <input type="hidden" name="Dir" value="@Model.Dir" />
    @if (Model.HasFilters)
    {
        <a id="clear-filters" asp-page="/Events/Index" asp-all-route-data="Model.ClearedRouteValues()">Clear filters</a>
    }
</form>

@if (Model.Events.Count == 0)
{
    <p id="no-events-message" class="empty">
        @if (Model.HasFilters)
        {
            <text>No events match these filters.</text>
        }
        else
        {
            <text>No events yet. One is recorded when a torrent is grabbed, linked or removed from MAM.</text>
        }
    </p>
}
else
{
    <table class="phone-cards event-table">
        <thead>
            <tr>
                <th class="col-fit" sort-by="OccurredAt" sort-first-descending="true" sort-state="Model.SortState" sort-page="/Events/Index" sort-route="Model.FilterRouteValues()">Occurred at</th>
                <th class="col-fit" sort-by="Type" sort-state="Model.SortState" sort-page="/Events/Index" sort-route="Model.FilterRouteValues()">Type</th>
                <th>Torrent</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Events)
            {
                <tr>
                    <td class="col-fit event-time"><local-time value="e.OccurredAt" short /></td>
                    <td class="col-fit event-type">@EventLabels.For(e.Kind)</td>
                    <td class="col-min event-torrent">
                        @if (e.TorrentId is not null)
                        {
                            <a asp-page="/Torrents/Detail" asp-route-id="@e.TorrentId" title="@e.TorrentId">@Model.TorrentLabel(e)</a>
                        }
                    </td>
                    <td class="break event-details">
                        @{ var details = EventLabels.Details(e); }
                        @if (EventLabels.Shortened(details) is { } shortened)
                        {
                            @shortened<button type="button" class="link-button details-more" data-details="@details">... more</button>
                        }
                        else
                        {
                            @details
                        }
                        @if (Model.Replacement(e) is { } replacement)
                        {
                            <span class="event-replacement">
                                Replaced by <a asp-page="/Torrents/Detail" asp-route-id="@replacement.TorrentId" title="@replacement.TorrentId">@replacement.Title</a>@(string.IsNullOrEmpty(replacement.Format) ? "" : $" ({replacement.Format})")
                            </span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @await Html.PartialAsync("_Pager", Model.Pager)

    @* Details too long for the table open here whole: "... more" carries the text in data-details. *@
    <dialog id="details-dialog" class="hit-dialog" aria-label="Event details">
        <div class="hit-dialog-bar">
            <button type="button" id="details-dialog-close">Close</button>
        </div>
        <p id="details-dialog-text" class="details-full"></p>
    </dialog>
    <script>
        (function () {
            const dialog = document.getElementById('details-dialog');
            const text = document.getElementById('details-dialog-text');
            document.querySelectorAll('.details-more').forEach(function (button) {
                button.addEventListener('click', function () {
                    text.textContent = button.dataset.details;
                    dialog.showModal();
                });
            });
            document.getElementById('details-dialog-close').addEventListener('click', function () {
                dialog.close();
            });
            dialog.addEventListener('click', function (event) {
                if (event.target === dialog) {
                    dialog.close();
                }
            });
        })();
    </script>
}
