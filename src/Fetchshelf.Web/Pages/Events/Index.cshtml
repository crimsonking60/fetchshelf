@page
@model Fetchshelf.Web.Pages.Events.IndexModel
@{
    ViewData["Title"] = "Events";
}

<h2>Events</h2>
@await Html.PartialAsync("_PageExplanation", "This page is a log of everything Fetchshelf has done, such as grabbing, linking, and cleaning up torrents. Filter by type, by the job that grabbed a torrent, or by the library that linked it; updates can also be filtered by the field they changed.")

@* A changed dropdown applies straight away, as on the Torrents page. *@
<form method="get" class="toolbar">
    <select name="Type" aria-label="Type" onchange="this.form.requestSubmit()">
        <option value="">All types</option>
        @foreach (var kind in Enum.GetValues<Fetchshelf.Data.Entities.EventKind>())
        {
            <option value="@kind" selected="@(Model.Type == kind)">@EventLabels.For(kind)</option>
        }
    </select>
    <select name="Grabber" aria-label="Grabbed by" onchange="this.form.requestSubmit()">
        <option value="">Grabbed by any job</option>
        @foreach (var grabber in Model.GrabberOptions)
        {
            <option value="@grabber" selected="@(Model.Grabber == grabber)">@grabber</option>
        }
    </select>
    <select name="Linker" aria-label="Library" onchange="this.form.requestSubmit()">
        <option value="">Any library</option>
        @foreach (var linker in Model.LinkerOptions)
        {
            <option value="@linker" selected="@(Model.Linker == linker)">@linker</option>
        }
    </select>
    @if (Model.FiltersByField)
    {
        <select name="Field" aria-label="Changed field" onchange="this.form.requestSubmit()">
            <option value="">Any changed field</option>
            @foreach (var field in IndexModel.FieldOptions)
            {
                <option value="@field" selected="@(Model.Field == field)">@EventLabels.FieldName(field)</option>
            }
        </select>
    }
    <input type="hidden" name="PageSize" value="@Model.PageSize" />
    @if (Model.HasFilters)
    {
        <a id="clear-filters" asp-page="/Events/Index" asp-all-route-data="Model.ClearedRouteValues()">Clear filters</a>
    }
</form>

@if (Model.Events.Count == 0)
{
    <p id="no-events-message" class="empty">No events.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Occurred at</th>
                <th>Type</th>
                <th>Torrent</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model.Events)
            {
                <tr>
                    <td><local-time value="e.OccurredAt" /></td>
                    <td class="nowrap">@EventLabels.For(e.Kind)</td>
                    <td class="nowrap">
                        @if (e.TorrentId is not null)
                        {
                            <a asp-page="/Torrents/Detail" asp-route-id="@e.TorrentId" title="@e.TorrentId">@Model.TorrentLabel(e)</a>
                        }
                    </td>
                    <td>
                        @switch (e.Kind)
                        {
                            case Fetchshelf.Data.Entities.EventKind.Linked:
                                @:Linked@(string.IsNullOrEmpty(e.LinkerName) ? "" : $" by {e.LinkerName}") to @e.LibraryPath
                                break;
                            case Fetchshelf.Data.Entities.EventKind.Cleaned:
                                @:Cleaned@(string.IsNullOrEmpty(e.LinkerName) ? "" : $" ({e.LinkerName})"), removed files: @EventLabels.RemovedFiles(e.FilesRemovedJson)
                                break;
                            case Fetchshelf.Data.Entities.EventKind.Unlinked:
                                @:Unlinked@(string.IsNullOrEmpty(e.LinkerName) ? "" : $" ({e.LinkerName})"), removed files: @EventLabels.RemovedFiles(e.FilesRemovedJson)
                                break;
                            case Fetchshelf.Data.Entities.EventKind.Updated:
                                @:@(e.EditedByHand == true ? "Edited by hand: " : "")@EventLabels.FieldChanges(e.FieldChangesJson)
                                break;
                            case Fetchshelf.Data.Entities.EventKind.Grabbed:
                                @:Grabbed@(string.IsNullOrEmpty(e.GrabberName) ? "" : $" by {e.GrabberName}") (cost: @e.Cost)
                                break;
                            case Fetchshelf.Data.Entities.EventKind.RemovedFromMam:
                                @:Removed from MAM
                                break;
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @await Html.PartialAsync("_Pager", Model.Pager)
}
