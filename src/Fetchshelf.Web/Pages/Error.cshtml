@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h2>Something went wrong</h2>
<p class="notice error" role="alert">Fetchshelf ran into an unexpected problem and could not finish this request.</p>
<p>
    The details are in the log: <code>docker logs fetchshelf</code>, or the files in the folder set by
    <code>FETCHSHELF_LOG_DIR</code>. Go back and try again; if it keeps happening, the log says what went wrong.
</p>
