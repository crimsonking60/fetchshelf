@page
@model IndexModel
@{
    ViewData["Title"] = "Search";
}

<h2>Search</h2>
@await Html.PartialAsync("_PageExplanation", "This page searches MAM directly for a title or author, or shows the newest torrents on MAM when you haven't typed anything. Download a result straight to qBittorrent, download it with a wedge applied, hide torrents you already have, or show only ebooks/audiobooks.")

@* Stays below the sticky header while scrolling, so feedback from a download is visible wherever in the results it was clicked. *@
<div id="download-message-area" class="download-feedback" aria-live="polite">
    @if (!string.IsNullOrEmpty(Model.DownloadMessage))
    {
        @await Html.PartialAsync("_DownloadMessagePartial", (Model.DownloadMessage, false))
    }
</div>

<form method="get" class="toolbar">
    <input type="text" name="Q" value="@Model.Q" placeholder="Search MAM" />
    <button type="submit">Search</button>
</form>

<div id="search-filters">
    <label>
        <input type="checkbox" id="hide-downloaded" />
        Hide downloaded torrents
    </label>
    <span id="media-filter">
        Show:
        <label class="show-filter-all show-filter-active" data-media-filter="All">
            <input type="radio" name="MediaFilter" value="All" checked class="visually-hidden" />
            All
        </label>
        <label class="show-filter-ebooks" data-media-filter="Ebooks">
            <input type="radio" name="MediaFilter" value="Ebooks" class="visually-hidden" />
            Ebooks
        </label>
        <label class="show-filter-audiobooks" data-media-filter="Audiobooks">
            <input type="radio" name="MediaFilter" value="Audiobooks" class="visually-hidden" />
            Audiobooks
        </label>
        <label class="show-filter-comic" data-media-filter="Comics">
            <input type="radio" name="MediaFilter" value="Comics" class="visually-hidden" />
            Comics
        </label>
        <label class="show-filter-other" data-media-filter="Other">
            <input type="radio" name="MediaFilter" value="Other" class="visually-hidden" />
            Other
        </label>
    </span>
</div>

@if (string.IsNullOrWhiteSpace(Model.Q))
{
    <h3>Newest on MAM</h3>
}
else
{
    <h3>Matches for '@Model.Q'</h3>
}

<div class="results-wrap">
    <div id="search-results-panel" hx-get="@Url.Page("/Index", "Results", new { Model.Q })" hx-trigger="load" hx-swap="innerHTML" hx-indicator="#search-loading">
        @await Html.PartialAsync("_SearchResultsPartial", Model)
    </div>
    @* Starts visible (htmx-request) so the table is never shown empty before the first request begins; htmx clears it when the request ends. *@
    <div id="search-loading" class="loading-overlay htmx-indicator htmx-request" role="status">
        <div class="loading-chip">
            <span class="spinner" aria-hidden="true"></span>
            <span>Searching MAM…</span>
        </div>
    </div>
</div>

<dialog id="hit-dialog" class="hit-dialog" aria-label="Torrent details">
    <div class="hit-dialog-bar">
        <button type="button" id="hit-dialog-close">Close</button>
    </div>
    <div id="hit-dialog-body"></div>
</dialog>

@section Scripts {
    <script>
        (function () {
            const slugByFilter = { Ebooks: 'ebook', Audiobooks: 'audiobook', Comics: 'comic', Other: 'other' };
            const hideDownloadedCheckbox = document.getElementById('hide-downloaded');
            let currentMediaFilter = 'All';

            function applyFilters() {
                const mediaSlug = slugByFilter[currentMediaFilter];
                const hideDownloaded = hideDownloadedCheckbox != null && hideDownloadedCheckbox.checked;
                document.querySelectorAll('#search-results tbody tr').forEach(function (row) {
                    const matchesMedia = !mediaSlug || row.dataset.mediaType === mediaSlug;
                    const matchesStatus = !hideDownloaded || (row.dataset.status === 'none' && row.dataset.inQbittorrent !== 'true');
                    row.hidden = !(matchesMedia && matchesStatus);
                });
                document.querySelectorAll('#media-filter [data-media-filter]').forEach(function (button) {
                    const isActive = button.dataset.mediaFilter === currentMediaFilter;
                    button.classList.toggle('show-filter-active', isActive);
                    button.querySelector('input').checked = isActive;
                });
            }

            document.querySelectorAll('#media-filter [data-media-filter]').forEach(function (button) {
                button.addEventListener('click', function () {
                    currentMediaFilter = button.dataset.mediaFilter;
                    applyFilters();
                });
            });
            if (hideDownloadedCheckbox != null) {
                hideDownloadedCheckbox.addEventListener('change', applyFilters);
            }
            // A result's details open in a dialog over the results, so the results, filters and scroll position stay put.
            const hitDialog = document.getElementById('hit-dialog');
            const hitDialogBody = document.getElementById('hit-dialog-body');
            document.body.addEventListener('htmx:beforeRequest', function (event) {
                if (event.detail.target === hitDialogBody) {
                    hitDialogBody.innerHTML = '<p class="muted">Loading…</p>';
                    if (!hitDialog.open) {
                        hitDialog.showModal();
                    }
                }
            });
            document.getElementById('hit-dialog-close').addEventListener('click', function () {
                hitDialog.close();
            });
            hitDialog.addEventListener('click', function (event) {
                if (event.target === hitDialog) {
                    hitDialog.close();
                }
            });

            // The table arrives after page load, so filters must be re-applied to each new set of rows.
            document.body.addEventListener('htmx:afterSwap', function (event) {
                if (event.target.id === 'search-results-panel') {
                    applyFilters();
                }
            });
            applyFilters();
        })();
    </script>
}
