@page
@model IndexModel
@{
    ViewData["Title"] = "Search";
}

<h2>Search</h2>
@await Html.PartialAsync("_PageExplanation", "This page searches MAM directly, by default in titles and authors, or shows the newest torrents on MAM when the search box is empty. Below the box: where to search in, which torrents to search (freeleech, VIP, the account's bookmarks, or those not snatched yet), and the order; results come 100 to a page. The language list starts at the languages set in the configuration. A result can be downloaded straight to qBittorrent, into a chosen category, or with a wedge applied; torrents already downloaded can be hidden, and the list limited to ebooks or audiobooks.")

@* Stays below the sticky header while scrolling, so feedback from a download is visible wherever in the results it was clicked. *@
<div id="download-message-area" class="download-feedback" aria-live="polite">
    @if (!string.IsNullOrEmpty(Model.DownloadMessage))
    {
        @await Html.PartialAsync("_DownloadMessagePartial", (Model.DownloadMessage, false))
    }
</div>

@* A changed choice searches again from the first page: the page number is not part of this form. *@
<form method="get" class="toolbar-stack" id="search-form">
    <div class="toolbar">
        <input type="text" name="Q" value="@Model.Q" placeholder="Search MAM" />
        <select name="Lang" id="search-language" aria-label="Language" onchange="this.form.requestSubmit()">
            @foreach (var (value, label) in Model.LanguageOptions)
            {
                <option value="@value" selected="@(value == Model.SelectedLanguageOption)">@label</option>
            }
        </select>
        <select name="Type" id="search-type" aria-label="Search type" onchange="this.form.requestSubmit()">
            @foreach (var (value, label) in SearchQueryBuilder.TypeOptions)
            {
                <option value="@value" selected="@(value == Model.SearchType)">@label</option>
            }
        </select>
        <select name="Sort" id="search-sort" aria-label="Sort" onchange="this.form.requestSubmit()">
            @foreach (var (value, label, _) in SearchQueryBuilder.SortOptions)
            {
                <option value="@value" selected="@(value == Model.SearchSort)">@label</option>
            }
        </select>
        <button type="submit">Search</button>
    </div>
    <details id="search-fields" class="search-fields">
        <summary>Search in: @string.Join(", ", SearchQueryBuilder.FieldOptions.Where(o => Model.SearchFields.Contains(o.Value)).Select(o => o.Label.ToLowerInvariant()))</summary>
        @foreach (var (value, label) in SearchQueryBuilder.FieldOptions)
        {
            <label><input type="checkbox" name="In" value="@value" checked="@Model.SearchFields.Contains(value)" /> @label</label>
        }
    </details>
</form>


@{
    var languageSuffix = Model.SearchLanguages.Count == 0
        ? string.Empty
        : " in " + string.Join(", ", Model.SearchLanguages.Select(Fetchshelf.Core.Metadata.LanguageNameResolver.DisplayName));
}
@if (string.IsNullOrWhiteSpace(Model.Q))
{
    <h3>@Model.BrowseHeading@(languageSuffix)</h3>
}
else
{
    <h3>Matches for '@Model.Q'@(languageSuffix)@(Model.SearchTypeLabel is { } typeLabel ? $" ({typeLabel})" : "")</h3>
}

<div class="results-wrap">
    @* hx-disinherit: the "Searching MAM" overlay is for this request only, not the buttons and status checks inside. *@
    <div id="search-results-panel" hx-get="@Url.Page("/Index", "Results", Model.SearchRouteValues())" hx-trigger="load" hx-swap="innerHTML" hx-indicator="#search-loading" hx-disinherit="hx-indicator">
        @await Html.PartialAsync("_SearchResultsPartial", Model)
    </div>
    @* Starts visible (htmx-request) so the table is never shown empty before the first request begins; htmx clears it when the request ends. *@
    <div id="search-loading" class="loading-overlay htmx-indicator htmx-request" role="status">
        <div class="loading-chip">
            <span class="spinner" aria-hidden="true"></span>
            <span>Searching MAM…</span>
        </div>
    </div>
</div>

<partial name="_HitDialog" />

@section Scripts {
    <script>
        (function () {
            const slugByFilter = { Ebooks: 'ebook', Audiobooks: 'audiobook', Comics: 'comic', Other: 'other' };
            // The filters sit in the results panel, which the results replace once they arrive: a choice made while MAM
            // is being searched is kept here and put back on the new controls, which are listened to through the page.
            let currentMediaFilter = 'All';
            let hideDownloaded = false;

            function applyFilters() {
                const mediaSlug = slugByFilter[currentMediaFilter];
                const hideDownloadedCheckbox = document.getElementById('hide-downloaded');
                if (hideDownloadedCheckbox != null) {
                    hideDownloadedCheckbox.checked = hideDownloaded;
                }
                document.querySelectorAll('#search-results tbody tr').forEach(function (row) {
                    const matchesMedia = !mediaSlug || row.dataset.mediaType === mediaSlug;
                    const matchesStatus = !hideDownloaded || (row.dataset.status === 'none' && row.dataset.inQbittorrent !== 'true');
                    row.hidden = !(matchesMedia && matchesStatus);
                });
                const hiddenNote = document.getElementById('results-hidden');
                if (hiddenNote != null) {
                    const hidden = document.querySelectorAll('#search-results tbody tr[hidden]').length;
                    hiddenNote.textContent = hidden === 0 ? '' : ' ' + hidden + ' hidden by the filters above.';
                }
                document.querySelectorAll('#media-filter [data-media-filter]').forEach(function (button) {
                    const isActive = button.dataset.mediaFilter === currentMediaFilter;
                    button.classList.toggle('show-filter-active', isActive);
                    button.querySelector('input').checked = isActive;
                });
            }

            document.body.addEventListener('click', function (event) {
                const button = event.target.closest('#media-filter [data-media-filter]');
                if (button != null) {
                    currentMediaFilter = button.dataset.mediaFilter;
                    applyFilters();
                }
            });
            document.body.addEventListener('change', function (event) {
                if (event.target.id === 'hide-downloaded') {
                    hideDownloaded = event.target.checked;
                    applyFilters();
                }
            });
            // A download swaps its row in out of band: it may now be hidden by "Hide downloaded torrents", and the count changes.
            document.body.addEventListener('htmx:oobAfterSwap', applyFilters);
            // The table arrives after page load, so filters must be re-applied to each new set of rows.
            document.body.addEventListener('htmx:afterSwap', function (event) {
                if (event.target.id === 'search-results-panel') {
                    applyFilters();
                }
            });
            applyFilters();
        })();
    </script>
}
