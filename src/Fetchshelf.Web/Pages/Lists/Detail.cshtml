@page "{id}"
@model Fetchshelf.Web.Pages.Lists.DetailModel
@{
    ViewData["Title"] = Model.ListName;
}

<h2>@Model.ListName</h2>
@await Html.PartialAsync("_PageExplanation", Model.IsBookmarks
    ? "This page shows the torrents bookmarked on MAM and what happened to each. A bookmark not yet selected or in the library is looked at again on every run of the list, so one that turns freeleech is taken. Mark a bookmark done to leave it alone."
    : $"This page shows the books {(Model.IsFile ? "in this list file" : "on this Hardcover shelf or list")} and what Fetchshelf found on MAM for each format. A book still missing a format is searched for again once a day. Mark a book done to stop searching for it.")
@if (Model.FilePath is not null)
{
    <p class="muted">File: <code>@Model.FilePath</code></p>
}
<p class="muted">Last read from @(Model.IsFile ? "the file" : Model.IsBookmarks ? "MAM" : "Hardcover"): <local-time value="Model.UpdatedAt" empty="never" /></p>

<form method="get" class="toolbar">
    <input type="hidden" name="PageSize" value="@Model.PageSize" />
    <select name="Show" aria-label="Show" onchange="this.form.requestSubmit()">
        <option value="" selected="@(string.IsNullOrEmpty(Model.Show))">All books</option>
        <option value="any" selected="@(Model.Show == "any")">Missing a format</option>
        <option value="audio" selected="@(Model.Show == "audio")">Missing the audiobook</option>
        <option value="ebook" selected="@(Model.Show == "ebook")">Missing the ebook</option>
    </select>
    <label><input type="checkbox" name="Removed" value="true" checked="@Model.Removed" onchange="this.form.requestSubmit()" /> Include books no longer on the list</label>
    <button type="submit">Filter</button>
</form>

@if (Model.Items.Count == 0)
{
    <p id="no-items-message" class="empty">@(Model.UpdatedAt is null
        ? $"Fetchshelf has not read this list from {(Model.IsFile ? "its file" : Model.IsBookmarks ? "MAM" : "Hardcover")} yet. Its books appear here after the list's first run that is not a dry run."
        : "No books to show.")</p>
}
else
{
    @foreach (var item in Model.Items)
    {
        <div class="list_item">
            @if (item.CoverUrl is not null)
            {
                <img src="@item.CoverUrl" alt="" loading="lazy" />
            }
            else
            {
                <div></div>
            }
            <div>
                <h3>
                    @item.Title
                    @if (item.Removed)
                    {
                        <span class="muted">(no longer on the list)</span>
                    }
                    @if (item.MarkedDone)
                    {
                        <span class="muted">(done)</span>
                    }
                </h3>
                <p class="author">by @string.Join(", ", item.Authors)</p>
                @if (item.SeriesText is not null)
                {
                    <p>@item.SeriesText</p>
                }
                @if (item.Audio is { } audio)
                {
                    <p>Audiobook: @if (audio.Link is not null) { <a href="@audio.Link">@audio.Text</a> } else { @audio.Text }</p>
                }
                @if (item.Ebook is { } ebook)
                {
                    <p>Ebook: @if (ebook.Link is not null) { <a href="@ebook.Link">@ebook.Text</a> } else { @ebook.Text }</p>
                }
                <p>
                    @if (item.TorrentDetailsUrl is not null)
                    {
                        <a href="@item.TorrentDetailsUrl">Torrent details</a>
                    }
                    else
                    {
                        <a href="@item.MamSearchUrl">Search MAM</a>
                    }
                    @if (item.BookUrl is not null)
                    {
                        <text> · </text><a href="@item.BookUrl" target="_blank" rel="noreferrer">On Hardcover</a>
                    }
                </p>
                @if (item.NextSearch is { } next)
                {
                    <p class="muted next-search">
                        @if (item.MissingSince is { } missing)
                        {
                            <text>Not on MAM since <local-time value="missing" />. </text>
                        }
                        @if (next > DateTimeOffset.UtcNow)
                        {
                            <text>Next search: <local-time value="next" /></text>
                        }
                        else
                        {
                            <text>Next search: on the list's next run.</text>
                        }
                    </p>
                }
                <div class="toolbar">
                    <form method="post" asp-page-handler="@(item.MarkedDone ? "UndoDone" : "MarkDone")" asp-all-route-data="Model.RouteValues()">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="externalId" value="@item.ExternalId" />
                        <input type="hidden" name="PageNumber" value="@Model.Pager.PageNumber" />
                        <button type="submit">@(item.MarkedDone ? "Undo done" : "Mark done")</button>
                    </form>
                    @if (item.CanSearchAgain)
                    {
                        @* The list's next run searches it, whenever it was last searched. *@
                        <form method="post" asp-page-handler="SearchAgain" asp-all-route-data="Model.RouteValues()">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="externalId" value="@item.ExternalId" />
                            <input type="hidden" name="PageNumber" value="@Model.Pager.PageNumber" />
                            <button type="submit" title="The list's next run searches MAM for this book">Search again</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }

    @await Html.PartialAsync("_Pager", Model.Pager)
}
