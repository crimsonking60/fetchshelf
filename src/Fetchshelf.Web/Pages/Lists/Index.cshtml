@page
@model Fetchshelf.Web.Pages.Lists.IndexModel
@{
    ViewData["Title"] = "Lists";
}

<h2>Lists</h2>
@await Html.PartialAsync("_PageExplanation", "This page shows your configured Goodreads lists, which Fetchshelf can use to autograb want-to-read books. Open a list to see which of its books are still missing from your library.")

@if (Model.ConfiguredLists.Count == 0)
{
    <p id="no-lists-message">You have no Goodreads lists.</p>
}
else
{
    @foreach (var list in Model.ConfiguredLists)
    {
        <div>
            <a asp-page="/Lists/Detail" asp-route-id="@list.Id"><h3>@list.Name</h3></a>
            Last updated: @(list.UpdatedAt?.ToString() ?? "never")
        </div>
    }
}

@if (Model.InactiveLists.Count > 0)
{
    <h3>Inactive Lists</h3>
    <p>Lists that have been removed from the config but are still in the database. They won't be refreshed or have books searched for at MaM.</p>
    @foreach (var list in Model.InactiveLists)
    {
        <div>
            <a asp-page="/Lists/Detail" asp-route-id="@list.Id"><h4>@list.Name</h4></a>
            Last updated: @(list.UpdatedAt?.ToString() ?? "never")
        </div>
    }
}
