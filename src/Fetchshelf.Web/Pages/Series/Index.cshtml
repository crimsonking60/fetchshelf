@page
@model Fetchshelf.Web.Pages.Series.IndexModel
@{
    ViewData["Title"] = "Series";
}

<h2>Series</h2>
@await Html.PartialAsync("_PageExplanation", Model.CanFollow
    ? "This page lists every series in the library, with the books it has and those missing between them. Set a series to Auto to have the Follow job download its missing and future books, follow it to have them listed on the Following page instead, or ignore it to leave it out of the series with missing books."
    : "This page lists every series in the library, with the books it has and those missing between them. With a [follow] section in the configuration, series can be followed here, so their missing and future books are downloaded or listed.")

<form method="get" class="toolbar">
    <input type="text" name="Q" value="@Model.Q" placeholder="Search series and authors" aria-label="Search" />
    <select name="Show" aria-label="Show" onchange="this.form.requestSubmit()">
        @* Not ignored, the first, is the default: an empty Show. *@
        @foreach (var (value, label) in Fetchshelf.Web.Pages.Series.IndexModel.ShowOptions)
        {
            <option value="@value" selected="@((Model.Show ?? string.Empty) == value)">@label</option>
        }
    </select>
    <input type="hidden" name="PageSize" value="@Model.PageSize" />
    <input type="hidden" name="Sort" value="@Model.Sort" />
    <input type="hidden" name="Dir" value="@Model.Dir" />
    <button type="submit" class="primary">Search</button>
</form>

@if (Model.Rows.Count == 0)
{
    <p id="no-series-message" class="empty">
        No series found.
        @if (!string.IsNullOrWhiteSpace(Model.Q) || !string.IsNullOrEmpty(Model.Show))
        {
            <text>Nothing matches. </text>
            <a id="empty-clear-filters" asp-page="/Series/Index" asp-route-PageSize="@Model.PageSize">Clear the search</a>
        }
    </p>
}
else
{
    <table id="series">
        <thead>
            <tr>
                <th sort-by="Name" sort-state="Model.SortState" sort-page="/Series/Index" sort-route="Model.RouteValues">Series</th>
                <th sort-by="Books" sort-first-descending="true" sort-state="Model.SortState" sort-page="/Series/Index" sort-route="Model.RouteValues">In the library</th>
                <th class="col-fit">Media types</th>
                <th class="col-fit" sort-by="Following" sort-state="Model.SortState" sort-page="/Series/Index" sort-route="Model.RouteValues">Following</th>
                @if (Model.CanFollow)
                {
                    <th class="col-fit"></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <partial name="_SeriesRowPartial" model="new Fetchshelf.Web.Pages.Series.SeriesRowPartialModel(row, Model.CanFollow)" />
            }
        </tbody>
    </table>
    @await Html.PartialAsync("_Pager", Model.Pager)
}
